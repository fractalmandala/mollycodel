+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * Provider configuration shared by the Providers editor (renderer) and the Pi
+ * agent (agent host process).
+ *
+ * Secrets never touch disk in plain text: the renderer keeps API keys in the OS
+ * keychain (secret storage) and pushes the full payload, keys included, to the
+ * host in memory over the authentication handshake whenever it changes or the
+ * host (re)starts. The host never persists it. The editor UI never receives a
+ * stored key back, only a "has key" flag.
+ */
+
+/** Resource name carried by the in-memory credential push to the Pi agent. */
+export const PI_PROVIDERS_RESOURCE = 'pi:providers';
+
+export type PiProviderKind =
+	/** A provider built into pi-ai; `id` is the pi-ai provider id. */
+	| 'builtin'
+	/** Any OpenAI-compatible endpoint (chat completions). */
+	| 'openai-compatible'
+	/** Any Anthropic-compatible endpoint (messages API). */
+	| 'anthropic-compatible'
+	/** Command Code's Provider API: one key, models served over either protocol (chosen per model). */
+	| 'command-code';
+
+/** The wire protocol a single model is spoken over. */
+export type PiModelApi = 'openai-completions' | 'anthropic-messages';
+
+export interface IPiModelConfig {
+	/** The model id sent to the provider. */
+	readonly id: string;
+	/** Optional display name. */
+	readonly alias?: string;
+	readonly contextWindow?: number;
+	readonly maxTokens?: number;
+	/** Protocol for this model. Used by `command-code` rows, where it varies per model. */
+	readonly api?: PiModelApi;
+}
+
+/** Non-secret provider configuration. */
+export interface IPiProviderConfig {
+	/** Unique row id. For `builtin` rows this equals the pi-ai provider id. */
+	readonly id: string;
+	readonly name: string;
+	readonly kind: PiProviderKind;
+	readonly enabled: boolean;
+	/** Base URL; required for compatible endpoints, ignored for built-ins. */
+	readonly baseUrl?: string;
+	/** Extra request headers (non-secret only). */
+	readonly headers?: Readonly<Record<string, string>>;
+	/** Model ids to offer. Required for compatible endpoints; optional for built-ins. */
+	readonly models: readonly IPiModelConfig[];
+}
+
+/** What the renderer pushes to the host: configuration plus in-memory keys. */
+export interface IPiProvidersPayload {
+	readonly providers: readonly (IPiProviderConfig & { readonly apiKey?: string })[];
+	/** Default model as `rowId/modelId`. */
+	readonly defaultModel?: string;
+}
+
+/** What the editor may see: configuration plus a flag, never the key. */
+export interface IPiProviderPublic extends IPiProviderConfig {
+	readonly hasKey: boolean;
+}
+
+const MAX_PROVIDERS = 200;
+const MAX_MODELS_PER_PROVIDER = 2000;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function sanitizeModels(raw: unknown): IPiModelConfig[] {
+	if (!Array.isArray(raw)) {
+		return [];
+	}
+	const seen = new Set<string>();
+	const result: IPiModelConfig[] = [];
+	for (const entry of raw.slice(0, MAX_MODELS_PER_PROVIDER)) {
+		if (!isRecord(entry) || typeof entry['id'] !== 'string' || !entry['id'].trim() || seen.has(entry['id'])) {
+			continue;
+		}
+		seen.add(entry['id']);
+		result.push({
+			id: entry['id'].trim(),
+			alias: typeof entry['alias'] === 'string' && entry['alias'].trim() ? entry['alias'].trim().slice(0, 60) : undefined,
+			contextWindow: typeof entry['contextWindow'] === 'number' && entry['contextWindow'] > 0 ? Math.floor(entry['contextWindow']) : undefined,
+			maxTokens: typeof entry['maxTokens'] === 'number' && entry['maxTokens'] > 0 ? Math.floor(entry['maxTokens']) : undefined,
+			api: entry['api'] === 'openai-completions' || entry['api'] === 'anthropic-messages' ? entry['api'] : undefined,
+		});
+	}
+	return result;
+}
+
+function sanitizeHeaders(raw: unknown): Record<string, string> | undefined {
+	if (!isRecord(raw)) {
+		return undefined;
+	}
+	const headers: Record<string, string> = {};
+	for (const [name, value] of Object.entries(raw).slice(0, 32)) {
+		if (typeof value === 'string' && /^[A-Za-z0-9-]+$/.test(name)) {
+			headers[name] = value;
+		}
+	}
+	return Object.keys(headers).length ? headers : undefined;
+}
+
+/** Validate untrusted JSON into a payload; invalid rows are dropped, never thrown on. */
+export function parsePiProvidersPayload(token: string): IPiProvidersPayload {
+	let raw: unknown;
+	try {
+		raw = JSON.parse(token);
+	} catch {
+		return { providers: [] };
+	}
+	if (!isRecord(raw) || !Array.isArray(raw['providers'])) {
+		return { providers: [] };
+	}
+	const ids = new Set<string>();
+	const providers: (IPiProviderConfig & { apiKey?: string })[] = [];
+	for (const entry of raw['providers'].slice(0, MAX_PROVIDERS)) {
+		if (!isRecord(entry) || typeof entry['id'] !== 'string' || !entry['id'].trim() || ids.has(entry['id'])) {
+			continue;
+		}
+		const kind = entry['kind'];
+		if (kind !== 'builtin' && kind !== 'openai-compatible' && kind !== 'anthropic-compatible' && kind !== 'command-code') {
+			continue;
+		}
+		const baseUrl = typeof entry['baseUrl'] === 'string' ? entry['baseUrl'].trim() : undefined;
+		if (kind !== 'builtin' && !baseUrl) {
+			continue;
+		}
+		ids.add(entry['id']);
+		providers.push({
+			id: entry['id'].trim(),
+			name: typeof entry['name'] === 'string' && entry['name'].trim() ? entry['name'].trim() : entry['id'].trim(),
+			kind,
+			enabled: entry['enabled'] !== false,
+			baseUrl: kind === 'builtin' ? undefined : baseUrl,
+			headers: sanitizeHeaders(entry['headers']),
+			models: sanitizeModels(entry['models']),
+			apiKey: typeof entry['apiKey'] === 'string' && entry['apiKey'] ? entry['apiKey'] : undefined,
+		});
+	}
+	return {
+		providers,
+		defaultModel: typeof raw['defaultModel'] === 'string' && raw['defaultModel'] ? raw['defaultModel'] : undefined,
+	};
+}
