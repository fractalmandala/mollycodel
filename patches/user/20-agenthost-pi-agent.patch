+			try {
+				await agent.prompt(prompt);
+			} finally {
+				unsubscribe();
+			}
+
+			if (entry.aborted) {
+				return; // the host already dispatched the cancellation
+			}
+			if (lastError) {
+				fail('pi.modelError', lastError);
+			} else {
+				this._fire(chat, { type: ActionType.ChatTurnComplete, turnId, duration: Date.now() - startedAt });
+			}
+		} catch (error) {
+			if (!entry.aborted) {
+				fail('pi.error', error instanceof Error ? error.message : String(error));
+			}
+		}
+	}
+
+	/** Map one Pi assistant stream event onto host response-part actions. */
+	private _onMessageUpdate(chat: URI, turnId: string, parts: Map<string, string>, event: { readonly type: string; readonly contentIndex?: number; readonly delta?: string }): void {
+		const index = event.contentIndex ?? 0;
+		switch (event.type) {
+			case 'text_start': {
+				const id = `pi-md-${++this._partCounter}`;
+				parts.set(`text:${index}`, id);
+				this._fire(chat, { type: ActionType.ChatResponsePart, turnId, part: { kind: ResponsePartKind.Markdown, id, content: '' } });
+				break;
+			}
+			case 'text_delta': {
+				const id = parts.get(`text:${index}`);
+				if (id && event.delta) {
+					this._fire(chat, { type: ActionType.ChatDelta, turnId, partId: id, content: event.delta });
+				}
+				break;
+			}
+			case 'thinking_start': {
+				const id = `pi-rs-${++this._partCounter}`;
+				parts.set(`thinking:${index}`, id);
+				this._fire(chat, { type: ActionType.ChatResponsePart, turnId, part: { kind: ResponsePartKind.Reasoning, id, content: '' } });
+				break;
+			}
+			case 'thinking_delta': {
+				const id = parts.get(`thinking:${index}`);
+				if (id && event.delta) {
+					this._fire(chat, { type: ActionType.ChatReasoning, turnId, partId: id, content: event.delta });
+				}
+				break;
+			}
+		}
+	}
+
+	/**
+	 * Called by Pi before each tool executes. Tells the host about the call,
+	 * waits for the user's approval when needed, and blocks denied or unsafe calls.
+	 */
+	private readonly _beforeToolCall = async (entry: IPiChat, context: Parameters<PiBeforeToolCall>[0], signal?: AbortSignal): ReturnType<PiBeforeToolCall> => {
+		const chat = entry.chat;
+		const turnId = entry.turnId ?? generateUuid();
+		const toolCall = context.toolCall;
+		const info = describePiTool(entry.cwd ?? '.', toolCall.name, context.args);
+		entry.toolInfo.set(toolCall.id, info);
+
+		this._fire(chat, { type: ActionType.ChatToolCallStart, turnId, toolCallId: toolCall.id, toolName: toolCall.name, displayName: info.displayName });
+
+		if (info.blockedReason) {
+			this._fire(chat, { type: ActionType.ChatToolCallReady, turnId, toolCallId: toolCall.id, invocationMessage: info.invocationMessage, toolInput: info.toolInput, confirmed: ToolCallConfirmationReason.NotNeeded });
+			return { block: true, reason: info.blockedReason };
+		}
+
+		if (!info.needsConfirmation) {
+			this._fire(chat, { type: ActionType.ChatToolCallReady, turnId, toolCallId: toolCall.id, invocationMessage: info.invocationMessage, toolInput: info.toolInput, confirmed: ToolCallConfirmationReason.NotNeeded });
+			return undefined;
+		}
+
+		const approval = new Promise<boolean>(resolve => {
+			this._pendingApprovals.set(toolCall.id, { chat, resolve });
+			signal?.addEventListener('abort', () => this.respondToPermissionRequest(toolCall.id, false), { once: true });
+		});
+		this._onDidChatProgress.fire({
+			kind: 'pending_confirmation',
+			chat,
+			state: {
+				status: ToolCallStatus.PendingConfirmation,
+				toolCallId: toolCall.id,
+				toolName: toolCall.name,
+				displayName: info.displayName,
+				invocationMessage: info.invocationMessage,
+				toolInput: info.toolInput,
+				confirmationTitle: info.invocationMessage,
+			},
+			permissionKind: info.permissionKind,
+			permissionPath: info.permissionPath,
+		});
+		if (await approval) {
+			return undefined;
+		}
+		entry.deniedTools.add(toolCall.id);
+		return { block: true, reason: 'The user did not approve this tool call.' };
+	};
+
+	/** Report a finished tool call to the host. */
+	private _onToolEnd(entry: IPiChat, turnId: string, toolCallId: string, result: unknown, isError: boolean): void {
+		if (entry.deniedTools.has(toolCallId)) {
+			return; // the host already finalized a denied call
+		}
+		const info = entry.toolInfo.get(toolCallId);
+		const blocks = (result && typeof result === 'object' && Array.isArray((result as { content?: unknown }).content)) ? (result as { content: { type?: string; text?: string }[] }).content : [];
+		const output = blocks.filter(block => block.type === 'text' && typeof block.text === 'string').map(block => block.text).join('\n');
+		const toolResult: ToolCallResult = {
+			success: !isError,
+			pastTenseMessage: info?.pastTenseMessage ?? 'Ran tool',
+			content: output ? [{ type: ToolResultContentType.Text, text: output }] : undefined,
+			error: isError ? { message: output || 'The tool failed.' } : undefined,
+		};
+		this._fire(entry.chat, { type: ActionType.ChatToolCallComplete, turnId, toolCallId, result: toolResult });
+	}
+
+	async materializeChat(chat: URI, _context: URI | IAgentChatContext, _providerData: string | undefined): Promise<IAgentCreateChatResult | void> {
+		this._entry(chat);
+	}
+
+	async getChatMetadata(chat: URI): Promise<IAgentChatMetadata | undefined> {
+		const entry = this._chats.get(chat.toString());
+		return entry && { chat, startTime: entry.startTime, modifiedTime: entry.modifiedTime };
+	}
+
+	async listChatsToMigrate(): Promise<readonly IAgentChatMetadata[] | undefined> {
+		return [];
+	}
+
+	// ---- Clients and interaction --------------------------------------------
+
+	getOrCreateActiveClient(_chat: URI, _context: URI | IAgentChatContext, client: { readonly clientId: string; readonly displayName?: string }, _hostCustomizations?: readonly Customization[]): IActiveClient {
+		return { clientId: client.clientId, displayName: client.displayName, tools: [], customizations: [] };
+	}
+
+	removeActiveClient(): void { }
+
+	onClientToolCallComplete(_chat: URI, _toolCallId: string, _result: ToolCallResult): void { }
+
+	respondToPermissionRequest(requestId: string, approved: boolean): void {
+		const pending = this._pendingApprovals.get(requestId);
+		if (pending) {
+			this._pendingApprovals.delete(requestId);
+			pending.resolve(approved);
+		}
+	}
+
+	/** Resolve every pending approval for a chat (used on abort and dispose). */
+	private _settleApprovals(chat: URI, approved: boolean): void {
+		for (const [id, pending] of this._pendingApprovals) {
+			if (pending.chat.toString() === chat.toString()) {
+				this._pendingApprovals.delete(id);
+				pending.resolve(approved);
+			}
+		}
+	}
+
+	respondToUserInputRequest(): void { }
+
+	// ---- Configuration -------------------------------------------------------
+
+	async resolveChatConfig(params: IAgentResolveChatConfigParams): Promise<ResolveSessionConfigResult> {
+		return { schema: { type: 'object', properties: {} }, values: params.config ?? {} };
+	}
+
+	getInheritedChatConfig(): undefined {
+		return undefined;
+	}
+
+	async chatConfigCompletions(_params: IAgentChatConfigCompletionsParams): Promise<SessionConfigCompletionsResult> {
+		return { items: [] };
+	}
+
+	async getChatCustomizations(): Promise<readonly Customization[]> {
+		return [];
+	}
+
+	// ---- Authentication ------------------------------------------------------
+
+	getProtectedResources(): ProtectedResourceMetadata[] {
+		return [];
+	}
+
+	async authenticate(_resource: string, _token: string): Promise<boolean> {
+		return true;
+	}
+
+	// ---- Lifecycle -----------------------------------------------------------
+
+	async shutdown(): Promise<void> {
+		for (const entry of this._chats.values()) {
+			entry.agent?.abort();
+		}
+	}
+}
+
+function setupModel(reason = 'No providers yet: run "Pi: Manage Providers"'): IAgentModelInfo {
+	return { provider: PI_AGENT_PROVIDER_ID, id: SETUP_MODEL_ID, name: reason, supportsVision: false };
+}
+
+function buildSystemPrompt(cwd: URI | undefined): string {
+	const lines = ['You are Pi, a concise and capable coding assistant running inside the editor.'];
+	if (cwd) {
+		lines.push(`The working directory is ${cwd.fsPath}. You can read and list files, write and edit files, and run shell commands there; writes and commands are shown to the user for approval.`);
+	}
+	return lines.join('\n');
+}
