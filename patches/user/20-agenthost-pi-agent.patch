@@ -0,0 +1,220 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { MessageKind, ResponsePartKind, ToolCallConfirmationReason, ToolCallStatus, ToolResultContentType, TurnState, type ResponsePart, type Turn } from '../../common/state/sessionState.js';
+import { describePiTool } from './piTools.js';
+
+/**
+ * Persisted Pi conversations.
+ *
+ * Two values live in the session's own database per chat: a small
+ * {@link IPiChatMeta} (read when sessions are listed, so a long conversation is
+ * never loaded just to show its title) and the full {@link IPiConversation}.
+ * Both are versioned JSON; anything unreadable is treated as absent, never thrown.
+ */
+
+export const PI_CONVERSATION_VERSION = 1;
+
+/** Refuse to persist a conversation beyond this size; the last good copy is kept instead. */
+export const PI_MAX_PERSISTED_BYTES = 40 * 1024 * 1024;
+
+/** Small record read when listing and restoring. */
+export interface IPiChatMeta {
+	readonly v: number;
+	readonly createdAt: number;
+	readonly modifiedAt: number;
+	readonly title?: string;
+	/** Selected model as `provider/id`. */
+	readonly model?: string;
+	/** Working directory (fsPath) the chat's tools run in. */
+	readonly cwd?: string;
+}
+
+/** Full persisted conversation. `messages` are Pi `AgentMessage`s, kept as opaque JSON. */
+export interface IPiConversation extends IPiChatMeta {
+	/** Host turn ids, one per user message in order, so the host's per-turn data reconnects after a restart. */
+	readonly turnIds: readonly string[];
+	readonly messages: readonly PiMessage[];
+}
+
+/** The subset of Pi's message shapes this module reads. Unknown roles are skipped. */
+export interface PiMessage {
+	readonly role: string;
+	readonly timestamp?: number;
+	readonly content?: unknown;
+	readonly toolCallId?: string;
+	readonly toolName?: string;
+	readonly isError?: boolean;
+	readonly usage?: { readonly input?: number; readonly output?: number; readonly cacheRead?: number };
+	readonly provider?: string;
+	readonly model?: string;
+	readonly stopReason?: string;
+	readonly errorMessage?: string;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function parseChatMeta(text: string | undefined): IPiChatMeta | undefined {
+	if (!text) {
+		return undefined;
+	}
+	try {
+		const raw: unknown = JSON.parse(text);
+		if (!isRecord(raw) || raw['v'] !== PI_CONVERSATION_VERSION || typeof raw['createdAt'] !== 'number' || typeof raw['modifiedAt'] !== 'number') {
+			return undefined;
+		}
+		return {
+			v: PI_CONVERSATION_VERSION,
+			createdAt: raw['createdAt'],
+			modifiedAt: raw['modifiedAt'],
+			title: typeof raw['title'] === 'string' ? raw['title'] : undefined,
+			model: typeof raw['model'] === 'string' ? raw['model'] : undefined,
+			cwd: typeof raw['cwd'] === 'string' ? raw['cwd'] : undefined,
+		};
+	} catch {
+		return undefined;
+	}
+}
+
+export function parseConversation(text: string | undefined): IPiConversation | undefined {
+	const meta = parseChatMeta(text);
+	if (!meta || !text) {
+		return undefined;
+	}
+	try {
+		const raw = JSON.parse(text) as Record<string, unknown>;
+		if (!Array.isArray(raw['messages'])) {
+			return undefined;
+		}
+		const messages = (raw['messages'] as unknown[]).filter((message): message is PiMessage => isRecord(message) && typeof message['role'] === 'string');
+		const turnIds = Array.isArray(raw['turnIds']) ? (raw['turnIds'] as unknown[]).filter((id): id is string => typeof id === 'string') : [];
+		return { ...meta, turnIds, messages };
+	} catch {
+		return undefined;
+	}
+}
+
+/** A short title from the first thing the user asked. */
+export function titleFromPrompt(prompt: string): string {
+	const line = prompt.trim().split(/\r?\n/)[0]?.trim() ?? '';
+	return line.length > 60 ? `${line.slice(0, 57)}...` : line;
+}
+
+function textOf(content: unknown): string {
+	if (typeof content === 'string') {
+		return content;
+	}
+	if (!Array.isArray(content)) {
+		return '';
+	}
+	return content
+		.filter((block): block is { type: string; text: string } => isRecord(block) && block['type'] === 'text' && typeof block['text'] === 'string')
+		.map(block => block.text)
+		.join('\n');
+}
+
+const iso = (time: number | undefined) => new Date(time ?? Date.now()).toISOString();
+
+/**
+ * Rebuild the display history from Pi's messages: one turn per user message, with
+ * the assistant's text, reasoning and tool calls in order. A tool call whose result
+ * was never recorded (the app was closed mid-call) is shown as failed rather than dropped.
+ */
+export function toTurns(messages: readonly PiMessage[], turnIds: readonly string[], cwd: string | undefined): Turn[] {
+	const results = new Map<string, PiMessage>();
+	for (const message of messages) {
+		if (message.role === 'toolResult' && message.toolCallId) {
+			results.set(message.toolCallId, message);
+		}
+	}
+
+	const turns: Turn[] = [];
+	let current: Turn | undefined;
+	let userIndex = 0;
+	let lastTimestamp = 0;
+
+	const finish = () => {
+		if (current && lastTimestamp) {
+			const started = Date.parse(current.startedAt ?? '');
+			if (!Number.isNaN(started) && lastTimestamp >= started) {
+				current.duration = lastTimestamp - started;
+			}
+		}
+	};
+
+	messages.forEach((message, index) => {
+		if (message.role === 'user') {
+			finish();
+			current = {
+				id: turnIds[userIndex] ?? `pi-turn-${index}`,
+				startedAt: iso(message.timestamp),
+				message: { text: textOf(message.content), origin: { kind: MessageKind.User } },
+				responseParts: [],
+				usage: undefined,
+				state: TurnState.Complete,
+			};
+			userIndex++;
+			turns.push(current);
+			lastTimestamp = message.timestamp ?? 0;
+			return;
+		}
+		if (message.role !== 'assistant' || !current) {
+			return;
+		}
+		lastTimestamp = message.timestamp ?? lastTimestamp;
+		const blocks = Array.isArray(message.content) ? message.content as Record<string, unknown>[] : [];
+		blocks.forEach((block, blockIndex) => {
+			const id = `pi-${index}-${blockIndex}`;
+			if (block['type'] === 'text' && typeof block['text'] === 'string' && block['text']) {
+				current!.responseParts.push({ kind: ResponsePartKind.Markdown, id, content: block['text'] });
+			} else if (block['type'] === 'thinking' && typeof block['thinking'] === 'string' && block['thinking']) {
+				current!.responseParts.push({ kind: ResponsePartKind.Reasoning, id, content: block['thinking'] });
+			} else if (block['type'] === 'toolCall' && typeof block['id'] === 'string' && typeof block['name'] === 'string') {
+				current!.responseParts.push(toolCallPart(block['id'], block['name'], block['arguments'], results.get(block['id']), cwd));
+			}
+		});
+		if (message.usage) {
+			const previous = current.usage;
+			current.usage = {
+				inputTokens: (previous?.inputTokens ?? 0) + (message.usage.input ?? 0),
+				outputTokens: (previous?.outputTokens ?? 0) + (message.usage.output ?? 0),
+				cacheReadTokens: (previous?.cacheReadTokens ?? 0) + (message.usage.cacheRead ?? 0),
+				model: message.provider && message.model ? `${message.provider}/${message.model}` : previous?.model,
+			};
+		}
+		if (message.stopReason === 'error') {
+			current.state = TurnState.Error;
+			current.error = { errorType: 'pi.modelError', message: message.errorMessage ?? 'The model returned an error.' };
+		} else if (message.stopReason === 'aborted') {
+			current.state = TurnState.Cancelled;
+		}
+	});
+	finish();
+	return turns;
+}
+
+function toolCallPart(toolCallId: string, name: string, args: unknown, result: PiMessage | undefined, cwd: string | undefined): ResponsePart {
+	const info = describePiTool(cwd ?? '.', name, args);
+	const output = result ? textOf(result.content) : '';
+	const failed = !result || result.isError === true;
+	return {
+		kind: ResponsePartKind.ToolCall,
+		toolCall: {
+			status: ToolCallStatus.Completed,
+			toolCallId,
+			toolName: name,
+			displayName: info.displayName,
+			invocationMessage: info.invocationMessage,
+			toolInput: info.toolInput,
+			confirmed: ToolCallConfirmationReason.NotNeeded,
+			success: !failed,
+			pastTenseMessage: info.pastTenseMessage,
+			content: output ? [{ type: ToolResultContentType.Text, text: output.slice(0, 20_000) }] : undefined,
+			error: failed ? { message: result ? (output || 'The tool failed.') : 'No result was recorded; the app was closed before the tool finished.' } : undefined,
+		},
+	};
+}
