@@ -0,0 +1,125 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Codicon } from '../../../../base/common/codicons.js';
+import { Disposable, DisposableStore } from '../../../../base/common/lifecycle.js';
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { IAgentHostService } from '../../../../platform/agentHost/common/agentService.js';
+import { PI_ENDPOINT_PRESETS, PI_PROVIDER_PRESETS } from '../../../../platform/agentHost/common/piProviderPresets.js';
+import { parsePiProvidersPayload } from '../../../../platform/agentHost/common/piProviders.js';
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { ACTIVE_GROUP, IEditorService } from '../../../services/editor/common/editorService.js';
+import { WebviewInput } from '../../webviewPanel/browser/webviewEditorInput.js';
+import { IWebviewWorkbenchService } from '../../webviewPanel/browser/webviewWorkbenchService.js';
+import { getPiProvidersHtml } from './piProvidersPage.js';
+import { IPiProvidersService } from './piProvidersService.js';
+
+const PI_AGENT_PROVIDER = 'pi';
+const SETUP_MODEL_ID = 'pi-setup-required';
+
+export const IPiProvidersEditorService = createDecorator<IPiProvidersEditorService>('piProvidersEditorService');
+
+export interface IPiProvidersEditorService {
+	readonly _serviceBrand: undefined;
+	/** Open the Providers editor, or focus it if it is already open. */
+	open(): void;
+}
+
+export class PiProvidersEditorService extends Disposable implements IPiProvidersEditorService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private _input: WebviewInput | undefined;
+
+	constructor(
+		@IWebviewWorkbenchService private readonly _webviewWorkbenchService: IWebviewWorkbenchService,
+		@IEditorService private readonly _editorService: IEditorService,
+		@IPiProvidersService private readonly _providers: IPiProvidersService,
+		@IAgentHostService private readonly _agentHostService: IAgentHostService,
+	) {
+		super();
+	}
+
+	open(): void {
+		if (this._input) {
+			void this._editorService.openEditor(this._input, { preserveFocus: false }, ACTIVE_GROUP);
+			return;
+		}
+		const input = this._input = this._webviewWorkbenchService.openWebview(
+			{
+				title: 'Pi Providers',
+				options: { retainContextWhenHidden: true },
+				contentOptions: { allowScripts: true },
+				extension: undefined,
+			},
+			'pi.providers',
+			'Pi Providers',
+			Codicon.settingsGear,
+			{ group: ACTIVE_GROUP, preserveFocus: false });
+
+		const disposables = new DisposableStore();
+		const webview = input.webview;
+		webview.setHtml(getPiProvidersHtml(generateUuid(), ''));
+
+		const sendState = async () => {
+			const state = await this._providers.getState();
+			const root = this._agentHostService.rootState.value;
+			const agent = root && !(root instanceof Error) ? root.agents.find(candidate => candidate.provider === PI_AGENT_PROVIDER) : undefined;
+			const models = (agent?.models ?? []).filter(model => model.id !== SETUP_MODEL_ID).map(model => ({ id: model.id, name: model.name }));
+			// The host publishes a placeholder model whose name explains why it has no real models.
+			const hostNote = models.length === 0 ? agent?.models?.find(model => model.id === SETUP_MODEL_ID)?.name : undefined;
+			await webview.postMessage({ type: 'state', state: { providers: state.providers, defaultModel: state.defaultModel, models, hostNote: state.providers.some(provider => provider.enabled) ? (hostNote ?? (agent ? undefined : 'The agent host is not connected yet.')) : undefined, presets: { builtin: PI_PROVIDER_PRESETS, extra: PI_ENDPOINT_PRESETS } } });
+		};
+
+		disposables.add(this._providers.onDidChange(() => void sendState()));
+		disposables.add(this._agentHostService.rootState.onDidChange(() => void sendState()));
+		disposables.add(webview.onMessage(async event => {
+			const message = event.message as { type: string; [key: string]: unknown };
+			switch (message.type) {
+				case 'ready':
+					await sendState();
+					break;
+				case 'save': {
+					// Validate with the same rules the host applies; never trust the page.
+					const parsed = parsePiProvidersPayload(JSON.stringify({ providers: [message['config']] })).providers[0];
+					if (parsed) {
+						const { apiKey: _ignored, ...config } = parsed;
+						const apiKey = message['apiKey'];
+						await this._providers.saveProvider(config, typeof apiKey === 'string' ? apiKey : apiKey === null ? null : undefined);
+					}
+					break;
+				}
+				case 'remove':
+					if (typeof message['id'] === 'string') {
+						await this._providers.removeProvider(message['id']);
+					}
+					break;
+				case 'toggle':
+					if (typeof message['id'] === 'string') {
+						await this._providers.setEnabled(message['id'], message['enabled'] === true);
+					}
+					break;
+				case 'setDefault':
+					await this._providers.setDefaultModel(typeof message['model'] === 'string' ? message['model'] : undefined);
+					break;
+				case 'discover': {
+					const request = message['request'] as { kind?: string; baseUrl?: string; apiKey?: string; providerId?: string } | undefined;
+					const result = await this._providers.discoverModels({
+						kind: request?.kind === 'anthropic-compatible' || request?.kind === 'command-code' ? request.kind : 'openai-compatible',
+						baseUrl: typeof request?.baseUrl === 'string' ? request.baseUrl : '',
+						apiKey: typeof request?.apiKey === 'string' ? request.apiKey : undefined,
+						providerId: typeof request?.providerId === 'string' ? request.providerId : undefined,
+					});
+					await webview.postMessage({ type: 'discoverResult', requestId: message['requestId'], ...result });
+					break;
+				}
+			}
+		}));
+		disposables.add(input.onWillDispose(() => {
+			disposables.dispose();
+			this._input = undefined;
+		}));
+	}
+}
