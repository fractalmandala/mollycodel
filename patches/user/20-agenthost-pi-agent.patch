+	cwd: string | undefined;
+	/** Turn currently running, for tool-call signals. */
+	turnId: string | undefined;
+	/** Tool calls in flight, by id: what we told the host about them. */
+	readonly toolInfo: Map<string, IPiToolInfo>;
+	/** Tool calls the user denied; the host already finalized them. */
+	readonly deniedTools: Set<string>;
+}
+
+/**
+ * Pi agent provider (phase 3 slice): runs Pi's agent loop (`pi-agent-core`) over
+ * `pi-ai`'s multi-provider models, streaming into the Agent Host. Text and
+ * reasoning only; tools, persistence and key setup UI come later.
+ *
+ * Requires no GitHub authentication and declares no protected resources.
+ */
+export class PiAgent extends Disposable implements IAgent {
+
+	readonly id = PI_AGENT_PROVIDER_ID;
+
+	private readonly _onDidChatProgress = this._register(new Emitter<AgentSignal>());
+	readonly onDidChatProgress = this._onDidChatProgress.event;
+	readonly onDidMaterializeChat = Event.None;
+	readonly onDidChangeChatData = Event.None;
+	readonly onDidSpawnChat = Event.None;
+	readonly onDidDiscoverChats: Event<readonly IAgentDiscoveredChat[]> = Event.None;
+
+	private readonly _models = observableValue<readonly IAgentModelInfo[]>(this, [setupModel()]);
+	readonly models = this._models;
+
+	private readonly _chats = new Map<string, IPiChat>();
+	private _partCounter = 0;
+	private _deps: Promise<IPiDeps> | undefined;
+	/** Live Pi model collection built from the providers pushed by the editor. */
+	private _piModels: PiModels | undefined;
+	private _payload: IPiProvidersPayload = { providers: [] };
+	/** Tool calls waiting for the user's approval, by tool call id. */
+	private readonly _pendingApprovals = new Map<string, { readonly chat: URI; readonly resolve: (approved: boolean) => void }>();
+
+	constructor(
+		@ILogService private readonly _logService: ILogService,
+	) {
+		super();
+		void this.refreshModels();
+	}
+
+	getDescriptor(): IAgentDescriptor {
+		return {
+			provider: PI_AGENT_PROVIDER_ID,
+			displayName: 'Pi',
+			description: 'Pi agent',
+			capabilities: {},
+		};
+	}
+
+	// ---- Runtime and models --------------------------------------------------
+
+	private _getDeps(): Promise<IPiDeps> {
+		this._deps ??= loadPiDeps();
+		return this._deps;
+	}
+
+	/**
+	 * Receives the provider configuration, with API keys, pushed in memory by the
+	 * editor over the authentication handshake. Nothing here is persisted.
+	 */
+	async handleAuthenticationToken(params: AuthenticateParams): Promise<boolean> {
+		if (params.resource !== PI_PROVIDERS_RESOURCE) {
+			return false;
+		}
+		this._payload = parsePiProvidersPayload(params.token);
+		const enabled = this._payload.providers.filter(row => row.enabled);
+		this._logService.info(`[Pi] received ${this._payload.providers.length} providers (${enabled.length} enabled, ${enabled.filter(row => row.apiKey).length} with a key)`);
+		await this.refreshModels();
+		return true;
+	}
+
+	/** Rebuild Pi's models from the current providers and republish the model list. */
+	async refreshModels(): Promise<void> {
+		try {
+			const deps = await this._getDeps();
+			const piModels = this._piModels = await buildPiModels(deps, this._payload);
+			const available = await piModels.getAvailable();
+			const infos = available
+				.filter(model => !NON_CHAT_MODEL.test(model.id))
+				.map((model): IAgentModelInfo => ({
+					provider: PI_AGENT_PROVIDER_ID,
+					id: `${model.provider}/${model.id}`,
+					name: `${model.name} (${this._providerName(model.provider)})`,
+					maxContextWindow: model.contextWindow,
+					maxOutputTokens: model.maxTokens,
+					supportsVision: model.input.includes('image'),
+				}));
+			this._logService.info(`[Pi] publishing ${infos.length} models from ${new Set(infos.map(info => info.id.split('/')[0])).size} providers`);
+			this._models.set(infos.length ? infos : [setupModel()], undefined);
+		} catch (error) {
+			this._logService.error('[Pi] failed to load providers', error);
+			this._models.set([setupModel(`Providers failed to load: ${error instanceof Error ? error.message : String(error)}`)], undefined);
+		}
+	}
+
+	private _providerName(providerId: string): string {
+		return this._payload.providers.find(row => row.id === providerId)?.name ?? providerId;
+	}
+
+	private _resolveModel(selection: string | undefined): PiModel | undefined {
+		const wanted = selection && selection !== SETUP_MODEL_ID ? selection : this._defaultModelId();
+		if (!wanted || !this._piModels) {
+			return undefined;
+		}
+		const [provider, ...rest] = wanted.split('/');
+		return this._piModels.getModel(provider, rest.join('/'));
+	}
+
+	/** The configured default if it is published, otherwise the first published model. */
+	private _defaultModelId(): string | undefined {
+		const ids = this._models.get().map(model => model.id).filter(id => id !== SETUP_MODEL_ID);
+		const configured = this._payload.defaultModel;
+		return configured && ids.includes(configured) ? configured : ids[0];
+	}
+
+	// ---- Chats ---------------------------------------------------------------
+
+	private _entry(chat: URI): IPiChat {
+		const key = chat.toString();
+		let entry = this._chats.get(key);
+		if (!entry) {
+			const now = Date.now();
+			entry = { chat, startTime: now, modifiedTime: now, model: undefined, agent: undefined, aborted: false, cwd: undefined, turnId: undefined, toolInfo: new Map(), deniedTools: new Set() };
+			this._chats.set(key, entry);
+		}
+		return entry;
+	}
+
+	private _fire(chat: URI, action: Extract<AgentSignal, { kind: 'action' }>['action']): void {
+		this._onDidChatProgress.fire({ kind: 'action', resource: chat, action });
+	}
+
+	readonly chats: IAgentChats = {
+		createChat: async (chat: URI, _context: URI | IAgentChatContext, options?: IAgentCreateChatOptions): Promise<IAgentCreateChatResult | void> => {
+			this._entry(chat).model = options?.model?.id;
+			return { resolvedWorkingDirectory: options?.workingDirectories?.[0] };
+		},
+		disposeChat: async (chat: URI): Promise<void> => {
