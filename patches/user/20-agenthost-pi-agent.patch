+					this._fire(chat, {
+						type: ActionType.ChatUsage,
+						turnId,
+						usage: { inputTokens: message.usage.input, outputTokens: message.usage.output, cacheReadTokens: message.usage.cacheRead, model: `${message.provider}/${message.model}` },
