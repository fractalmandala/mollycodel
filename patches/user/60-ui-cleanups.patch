@@ -0,0 +1,15 @@
+/*---------------------------------------------------------------------------------------------
+ *  mollycodel: one switch for "this app has no GitHub Copilot".
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * mollycodel ships without GitHub Copilot: its agents (Pi, OpenCode) use the user's own
+ * providers, so there is no account to sign in to, no entitlement to resolve and no quota.
+ *
+ * While this is `true`, the chat entitlement service never starts (no calls to GitHub),
+ * chat setup counts as finished, and the Copilot sign-in and status surfaces stay hidden.
+ * The product configuration's `defaultChatAgent` block is deliberately left in place
+ * because the extension gallery reads it without checking that it exists.
+ */
+export const MOLLYCODEL_NO_COPILOT = true;
