+ *--------------------------------------------------------------------------------------------*/
+
+import { RunOnceScheduler } from '../../../../base/common/async.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IAgentHostService } from '../../../../platform/agentHost/common/agentService.js';
+import { PI_PROVIDERS_RESOURCE, parsePiProvidersPayload, type IPiProviderConfig, type IPiProviderPublic, type PiModelApi, type PiProviderKind } from '../../../../platform/agentHost/common/piProviders.js';
+import { createDecorator } from '../../../../platform/instantiation/common/instantiation.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { asJson, IRequestService, isSuccess } from '../../../../platform/request/common/request.js';
+import { ISecretStorageService } from '../../../../platform/secrets/common/secrets.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+
+const STORAGE_KEY = 'pi.providers.v1';
+const secretKey = (providerId: string) => `pi.provider.${providerId}.apiKey`;
+const PUSH_DEBOUNCE_MS = 400;
+const DISCOVERY_TIMEOUT_MS = 15_000;
+const MAX_PUSH_RETRIES = 6;
+const PUSH_RETRY_MS = 2000;
+
+export const IPiProvidersService = createDecorator<IPiProvidersService>('piProvidersService');
+
+export interface IPiProvidersState {
+	readonly providers: readonly IPiProviderPublic[];
+	readonly defaultModel: string | undefined;
+}
+
+export interface IPiDiscoverRequest {
+	readonly kind: PiProviderKind;
+	readonly baseUrl: string;
+	readonly headers?: Readonly<Record<string, string>>;
+	/** A key typed in the form; takes precedence over a stored one. */
+	readonly apiKey?: string;
+	/** Reuse the stored key of this provider when no key was typed. */
+	readonly providerId?: string;
+}
+
+/** `apis` is present when the service says which protocol each model is served over. */
+export type PiDiscoverResult = { readonly ok: true; readonly models: readonly string[]; readonly apis?: Readonly<Record<string, PiModelApi>> } | { readonly ok: false; readonly error: string };
+
+export interface IPiProvidersService {
+	readonly _serviceBrand: undefined;
+	readonly onDidChange: Event<void>;
+	/** Configuration plus a `hasKey` flag per provider. Never contains a key. */
+	getState(): Promise<IPiProvidersState>;
+	/** `apiKey`: a string sets it, `null` removes it, `undefined` keeps the stored one. */
+	saveProvider(config: IPiProviderConfig, apiKey: string | null | undefined): Promise<void>;
+	removeProvider(id: string): Promise<void>;
+	setEnabled(id: string, enabled: boolean): Promise<void>;
+	setDefaultModel(model: string | undefined): Promise<void>;
+	discoverModels(request: IPiDiscoverRequest): Promise<PiDiscoverResult>;
+	/** Push the current providers, keys included, to the agent host (in memory only). */
+	pushToHost(): Promise<void>;
+}
+
+export class PiProvidersService extends Disposable implements IPiProvidersService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _onDidChange = this._register(new Emitter<void>());
+	readonly onDidChange = this._onDidChange.event;
+
+	private readonly _pushScheduler = this._register(new RunOnceScheduler(() => void this.pushToHost(), PUSH_DEBOUNCE_MS));
+	private _pushRetries = 0;
+
+	constructor(
+		@IStorageService private readonly _storageService: IStorageService,
+		@ISecretStorageService private readonly _secretStorageService: ISecretStorageService,
+		@IAgentHostService private readonly _agentHostService: IAgentHostService,
+		@IRequestService private readonly _requestService: IRequestService,
+		@ILogService private readonly _logService: ILogService,
+	) {
+		super();
+		// Another window edited the providers, or a key changed: re-sync.
+		this._register(this._storageService.onDidChangeValue(StorageScope.APPLICATION, STORAGE_KEY, this._store)(() => this._changed()));
+		this._register(this._secretStorageService.onDidChangeSecret(key => {
+			if (key.startsWith('pi.provider.')) {
+				this._changed();
+			}
+		}));
+		// The host forgets everything on restart; send it again.
+		this._register(this._agentHostService.onAgentHostStart(() => this._pushScheduler.schedule(0)));
+		this._pushScheduler.schedule(0);
+	}
+
+	private _changed(): void {
+		this._onDidChange.fire();
+		this._pushScheduler.schedule();
+	}
+
+	private _read(): { providers: IPiProviderConfig[]; defaultModel: string | undefined } {
+		const text = this._storageService.get(STORAGE_KEY, StorageScope.APPLICATION);
+		if (!text) {
+			return { providers: [], defaultModel: undefined };
+		}
+		// Reuse the host's validator so a hand-edited or corrupt value cannot poison the payload.
+		const parsed = parsePiProvidersPayload(text);
+		return { providers: parsed.providers.map(({ apiKey: _ignored, ...config }) => config), defaultModel: parsed.defaultModel };
+	}
+
+	private _write(state: { providers: readonly IPiProviderConfig[]; defaultModel: string | undefined }): void {
+		this._storageService.store(STORAGE_KEY, JSON.stringify(state), StorageScope.APPLICATION, StorageTarget.MACHINE);
+	}
+
+	async getState(): Promise<IPiProvidersState> {
+		const state = this._read();
+		const providers = await Promise.all(state.providers.map(async config => ({ ...config, hasKey: !!(await this._secretStorageService.get(secretKey(config.id))) })));
+		return { providers, defaultModel: state.defaultModel };
+	}
+
+	async saveProvider(config: IPiProviderConfig, apiKey: string | null | undefined): Promise<void> {
+		if (typeof apiKey === 'string' && apiKey) {
+			await this._secretStorageService.set(secretKey(config.id), apiKey);
+		} else if (apiKey === null) {
+			await this._secretStorageService.delete(secretKey(config.id));
+		}
+		const state = this._read();
+		const index = state.providers.findIndex(existing => existing.id === config.id);
+		const providers = index >= 0 ? state.providers.map((existing, i) => i === index ? config : existing) : [...state.providers, config];
+		this._write({ providers, defaultModel: state.defaultModel });
+		this._changed();
+	}
+
+	async removeProvider(id: string): Promise<void> {
+		const state = this._read();
+		await this._secretStorageService.delete(secretKey(id));
+		const defaultModel = state.defaultModel?.startsWith(`${id}/`) ? undefined : state.defaultModel;
+		this._write({ providers: state.providers.filter(existing => existing.id !== id), defaultModel });
+		this._changed();
+	}
+
+	async setEnabled(id: string, enabled: boolean): Promise<void> {
+		const state = this._read();
+		this._write({ providers: state.providers.map(existing => existing.id === id ? { ...existing, enabled } : existing), defaultModel: state.defaultModel });
+		this._changed();
+	}
+
+	async setDefaultModel(model: string | undefined): Promise<void> {
+		const state = this._read();
+		this._write({ providers: state.providers, defaultModel: model });
+		this._changed();
+	}
+
+	async pushToHost(): Promise<void> {
+		try {
+			const state = this._read();
+			const providers = await Promise.all(state.providers.map(async config => ({ ...config, apiKey: await this._secretStorageService.get(secretKey(config.id)) })));
+			const result = await this._agentHostService.authenticate({ resource: PI_PROVIDERS_RESOURCE, token: JSON.stringify({ providers, defaultModel: state.defaultModel }) });
+			this._pushRetries = 0;
+			this._logService.info(`[Pi providers] pushed ${providers.length} providers to the agent host (accepted: ${result.authenticated})`);
+		} catch (error) {
+			// The host may not be connected yet (startup race); retry a few times, and again on host start.
+			this._logService.warn(`[Pi providers] push to agent host failed: ${error instanceof Error ? error.message : String(error)}`);
+			if (this._pushRetries++ < MAX_PUSH_RETRIES) {
+				this._pushScheduler.schedule(PUSH_RETRY_MS);
+			}
+		}
+	}
+
+	async discoverModels(request: IPiDiscoverRequest): Promise<PiDiscoverResult> {
+		const baseUrl = request.baseUrl.trim().replace(/\/+$/, '');
+		try {
+			new URL(baseUrl);
+		} catch {
+			return { ok: false, error: 'Enter a valid base URL first.' };
+		}
+		const apiKey = request.apiKey || (request.providerId ? await this._secretStorageService.get(secretKey(request.providerId)) : undefined);
+		const headers: Record<string, string> = { Accept: 'application/json', ...request.headers };
+		if (apiKey) {
+			if (request.kind === 'anthropic-compatible') {
+				headers['x-api-key'] = apiKey;
+				headers['anthropic-version'] = '2023-06-01';
+			} else {
+				headers['Authorization'] = `Bearer ${apiKey}`;
+			}
+		}
+		// Anthropic-style endpoints serve /v1/models; OpenAI-style bases usually already end in /v1.
+		const candidates = request.kind === 'anthropic-compatible' && !/\/v1$/.test(baseUrl) ? [`${baseUrl}/v1/models`, `${baseUrl}/models`] : [`${baseUrl}/models`];
+		let lastError = 'The service did not return a model list.';
+		for (const url of candidates) {
+			try {
+				const context = await this._requestService.request({ type: 'GET', url, headers, timeout: DISCOVERY_TIMEOUT_MS, callSite: 'piProviders.discoverModels' }, CancellationToken.None);
+				if (!isSuccess(context)) {
+					const status = context.res.statusCode;
+					lastError = status === 401 || status === 403 ? 'The service rejected the key (or needs one). Check it and try again.'
+						: status === 404 ? 'This endpoint has no model list. Enter the model IDs by hand.'
+							: `The service answered with an error (${status}).`;
+					continue;
+				}
+				const body = await asJson<{ data?: { id?: unknown }[]; models?: ({ id?: unknown; name?: unknown } | string)[] }>(context);
+				const entries = body?.data ?? body?.models ?? [];
+				// Some gateways list `supported_endpoints` per model; the Messages endpoint means the Anthropic protocol.
+				const apis: Record<string, PiModelApi> = {};
+				for (const entry of entries) {
+					const endpoints = typeof entry === 'object' && entry ? (entry as { supported_endpoints?: unknown }).supported_endpoints : undefined;
+					const id = typeof entry === 'object' && entry ? (entry as { id?: unknown }).id : undefined;
+					if (typeof id === 'string' && Array.isArray(endpoints) && endpoints.length) {
+						apis[id] = endpoints.includes('/chat/completions') ? 'openai-completions' : endpoints.includes('/messages') ? 'anthropic-messages' : 'openai-completions';
+					}
+				}
+				const ids = entries
+					.map(entry => typeof entry === 'string' ? entry : typeof entry?.id === 'string' ? entry.id : typeof (entry as { name?: unknown })?.name === 'string' ? (entry as { name: string }).name : undefined)
+					.filter((id): id is string => !!id);
+				if (ids.length) {
+					return { ok: true, models: [...new Set(ids)].sort().slice(0, 2000), apis: Object.keys(apis).length ? apis : undefined };
+				}
+				lastError = 'The service returned an empty model list.';
+			} catch (error) {
+				lastError = `Could not reach the service: ${error instanceof Error ? error.message : String(error)}`;
+			}
+		}
+		return { ok: false, error: lastError };
+	}
+}
