+				this._settleApprovals(chat, false);
+				entry.agent.abort();
+			}
+		},
+		getModel: (chat: URI): ModelSelection | undefined => {
+			const model = this._chats.get(chat.toString())?.model;
+			return model ? { id: model } : undefined;
+		},
+		changeModel: async (chat: URI, model: ModelSelection): Promise<void> => {
+			this._entry(chat).model = model.id;
+		},
+		changeAgent: async (_chat: URI, _agent: AgentSelection | undefined): Promise<void> => { },
+		getMessages: async (): Promise<readonly Turn[]> => [],
+	};
+
+	private async _runTurn(entry: IPiChat, prompt: string, turnId: string, cwd: URI | undefined): Promise<void> {
+		const chat = entry.chat;
+		const startedAt = Date.now();
+		entry.modifiedTime = startedAt;
+		entry.aborted = false;
+		const fail = (errorType: string, message: string) => this._fire(chat, { type: ActionType.ChatError, turnId, duration: Date.now() - startedAt, error: { errorType, message } });
+
+		try {
+			const deps = await this._getDeps();
+			if (!this._piModels || (await this._piModels.getAvailable()).length === 0) {
+				fail('pi.noProviders', 'No AI providers are configured. Run "Pi: Manage Providers" from the Command Palette to add one.');
+				return;
+			}
+			const model = this._resolveModel(entry.model);
+			if (!model) {
+				fail('pi.unknownModel', `Model "${entry.model ?? 'default'}" is not available.`);
+				return;
+			}
+
+			const agent = entry.agent ??= new deps.core.Agent({
+				initialState: { systemPrompt: buildSystemPrompt(cwd), model },
+				// Always the live collection, so provider edits apply to existing chats.
+				streamFn: (...args) => this._piModels!.streamSimple(...args),
+			});
+			agent.state.model = model;
+			entry.cwd = cwd?.fsPath ?? entry.cwd;
+			entry.turnId = turnId;
+			entry.toolInfo.clear();
+			entry.deniedTools.clear();
+			agent.state.tools = entry.cwd ? createPiTools(entry.cwd) : [];
