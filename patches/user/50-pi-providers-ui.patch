@@ -0,0 +1,268 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * HTML for the Providers editor webview.
+ *
+ * Messages to the editor: ready, save, remove, toggle, setDefault, discover.
+ * Messages from the editor: state, discoverResult.
+ * The page never receives a stored API key, only a `hasKey` flag. All user data is
+ * rendered with `textContent`, never as HTML.
+ */
+export function getPiProvidersHtml(nonce: string, cspSource: string): string {
+	return `<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'nonce-${nonce}' ${cspSource}; script-src 'nonce-${nonce}';">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Pi Providers</title>
+<style nonce="${nonce}">
+:root {
+	--bg: var(--vscode-editor-background);
+	--fg: var(--vscode-editor-foreground);
+	--muted: var(--vscode-descriptionForeground);
+	--card: var(--vscode-editorWidget-background, rgba(128,128,128,.08));
+	--border: var(--vscode-editorWidget-border, rgba(128,128,128,.25));
+	--hover: var(--vscode-list-hoverBackground, rgba(128,128,128,.12));
+	--accent: var(--vscode-button-background);
+	--accent-fg: var(--vscode-button-foreground);
+	--accent-hover: var(--vscode-button-hoverBackground);
+	--danger: var(--vscode-errorForeground);
+	--ok: var(--vscode-testing-iconPassed, #3fb950);
+	--font: var(--vscode-font-family);
+	--mono: var(--vscode-editor-font-family, monospace);
+}
+* { box-sizing: border-box; }
+html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 13px; }
+.page { max-width: 980px; margin: 0 auto; padding: 28px 28px 80px; }
+h1 { font-size: 20px; font-weight: 600; margin: 0 0 4px; }
+.sub { color: var(--muted); margin: 0 0 22px; }
+.row-between { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+button { font: inherit; color: inherit; cursor: pointer; }
+.btn { border: 1px solid var(--border); background: transparent; border-radius: 8px; padding: 6px 12px; }
+.btn:hover { background: var(--hover); }
+.btn.primary { background: var(--accent); color: var(--accent-fg); border-color: transparent; font-weight: 600; }
+.btn.primary:hover { background: var(--accent-hover); }
+.btn.danger { color: var(--danger); }
+.btn:disabled { opacity: .5; cursor: default; }
+.icon-btn { border: 0; background: transparent; padding: 5px; border-radius: 6px; color: var(--muted); }
+.icon-btn:hover { background: var(--hover); color: var(--fg); }
+.section-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; margin: 26px 0 10px; }
+.count { font-size: 11px; font-weight: 600; background: var(--hover); border-radius: 999px; padding: 1px 8px; color: var(--muted); }
+.card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
+.default-row { padding: 12px 16px; }
+.default-row .label { font-weight: 600; }
+select, input[type=text], input[type=password], input[type=url], textarea {
+	width: 100%; font: inherit; color: var(--vscode-input-foreground); background: var(--vscode-input-background);
+	border: 1px solid var(--vscode-input-border, var(--border)); border-radius: 8px; padding: 7px 10px; outline: none;
+}
+select:focus, input:focus, textarea:focus { border-color: var(--vscode-focusBorder); }
+textarea { font-family: var(--mono); min-height: 110px; resize: vertical; }
+.default-row select { width: auto; min-width: 280px; }
+.provider { display: flex; align-items: center; gap: 12px; padding: 12px 16px; margin-bottom: 8px; }
+.provider.disabled { opacity: .55; }
+.mono { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; background: var(--hover); flex: none; }
+.provider .meta { flex: 1; min-width: 0; }
+.provider .name { font-weight: 600; display: flex; align-items: center; gap: 8px; }
+.provider .detail { color: var(--muted); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.badge { font-size: 11px; font-weight: 600; border-radius: 999px; padding: 1px 8px; background: var(--hover); color: var(--muted); }
+.badge.ok { color: var(--ok); }
+.badge.warn { color: var(--vscode-editorWarning-foreground, #d29922); }
+.badge.def { color: var(--ok); background: rgba(63,185,80,.14); }
+.switch { width: 38px; height: 22px; border-radius: 999px; border: 0; background: var(--border); position: relative; flex: none; padding: 0; }
+.switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); transition: left .12s; }
+.switch[aria-checked=true] { background: var(--accent); }
+.switch[aria-checked=true]::after { left: 19px; }
+.empty { padding: 28px 16px; text-align: center; color: var(--muted); }
+.overlay { position: fixed; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: flex-start; justify-content: center; padding: 6vh 16px; overflow: auto; z-index: 10; }
+.dialog { width: min(920px, 100%); background: var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 22px 24px 24px; box-shadow: 0 20px 60px rgba(0,0,0,.35); }
+.dialog h2 { margin: 0; font-size: 17px; }
+.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; }
+.service { display: flex; align-items: center; gap: 10px; text-align: left; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--card); width: 100%; }
+.service:hover:not(:disabled) { background: var(--hover); }
+.service:disabled { opacity: .55; cursor: default; }
+.service .t { min-width: 0; }
+.service .n { font-weight: 600; }
+.service .e { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
+.group { margin: 18px 0 8px; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
+.field { margin: 14px 0; }
+.field label { display: block; font-weight: 600; margin-bottom: 5px; }
+.hint { color: var(--muted); font-size: 12px; margin-top: 4px; }
+.status { font-size: 12px; margin-top: 6px; }
+.status.err { color: var(--danger); }
+.status.ok { color: var(--ok); }
+.actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
+.inline { display: flex; gap: 8px; align-items: center; }
+.mt { margin-top: 6px; }
+.note { margin-top: 12px; padding: 10px 14px; color: var(--vscode-editorWarning-foreground, #d29922); }
+</style>
+</head>
+<body>
+<div class="page" id="app"></div>
+<script nonce="${nonce}">
+(function () {
+	var vscode = acquireVsCodeApi();
+	var S = { providers: [], defaultModel: undefined, models: [], presets: { builtin: [], extra: [] } };
+	var dialog = null; // { step: 'pick'|'form', preset, editing, filter }
+	var discoverSeq = 0;
+	var app = document.getElementById('app');
+
+	function h(tag, attrs) {
+		var el = document.createElement(tag);
+		if (attrs) { for (var k in attrs) {
+			if (k === 'class') { el.className = attrs[k]; }
+			else if (k === 'text') { el.textContent = attrs[k]; }
+			else if (k.indexOf('on') === 0) { el.addEventListener(k.slice(2), attrs[k]); }
+			else if (attrs[k] !== undefined && attrs[k] !== false) { el.setAttribute(k, attrs[k] === true ? '' : attrs[k]); }
+		} }
+		for (var i = 2; i < arguments.length; i++) {
+			var c = arguments[i];
+			if (c === null || c === undefined || c === false) { continue; }
+			el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
+		}
+		return el;
+	}
+	function host(url) { try { var u = new URL(url); return u.host + u.pathname.replace(/\\/+$/, ''); } catch (e) { return url || ''; } }
+	function mono(name) { return h('div', { class: 'mono', text: (name || '?').trim().charAt(0).toUpperCase() }); }
+	function modelsOf(p) { return S.models.filter(function (m) { return m.id.indexOf(p.id + '/') === 0; }); }
+	function post(m) { vscode.postMessage(m); }
+
+	function render() {
+		app.textContent = '';
+		var enabledCount = S.providers.filter(function (p) { return p.enabled; }).length;
+		app.appendChild(h('div', { class: 'row-between' },
+			h('div', null, h('h1', { text: 'Pi providers' }), h('p', { class: 'sub', text: 'Connect the AI services Pi can use. API keys are stored in your operating system keychain and are never shown again.' })),
+			h('button', { class: 'btn primary', onclick: function () { dialog = { step: 'pick', filter: '' }; render(); } }, '+ Add provider')));
+
+		// Default model
+		var sel = h('select', { onchange: function (e) { post({ type: 'setDefault', model: e.target.value || undefined }); } });
+		sel.appendChild(h('option', { value: '', text: S.models.length ? 'First available model' : 'No models available yet' }));
+		S.models.forEach(function (m) { var o = h('option', { value: m.id, text: m.name }); if (m.id === S.defaultModel) { o.selected = true; } sel.appendChild(o); });
+		app.appendChild(h('div', { class: 'card default-row row-between' }, h('div', { class: 'label', text: 'Default model' }), sel));
+
+		if (S.hostNote) { app.appendChild(h('div', { class: 'card note', role: 'status' }, 'No models are loaded yet. ' + S.hostNote)); }
+		app.appendChild(h('div', { class: 'section-title' }, 'AI providers', h('span', { class: 'count', text: String(S.providers.length) })));
+		if (!S.providers.length) {
+			app.appendChild(h('div', { class: 'card empty', text: 'No providers yet. Add one to start using Pi.' }));
+		}
+		S.providers.forEach(function (p) {
+			var n = p.kind === 'builtin' ? modelsOf(p).length : p.models.length;
+			var detail = (p.kind === 'builtin' ? 'Built in' : host(p.baseUrl)) + ' \\u00b7 ' + n + ' model' + (n === 1 ? '' : 's');
