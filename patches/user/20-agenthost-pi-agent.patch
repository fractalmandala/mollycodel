+import type { AuthenticateParams, IActiveClient, IAgent, IAgentChatConfigCompletionsParams, IAgentChatContext, IAgentChatMetadata, IAgentChats, IAgentCreateChatOptions, IAgentCreateChatResult, IAgentDescriptor, IAgentDiscoveredChat, IAgentModelInfo, IAgentResolveChatConfigParams, AgentSignal } from '../../common/agent.js';
