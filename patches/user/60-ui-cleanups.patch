@@ -0,0 +1,98 @@
+/*---------------------------------------------------------------------------------------------
+ *  mollycodel: look-and-feel overrides, kept in one file so upstream merges stay trivial.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Title bar layout buttons (primary side bar, panel, secondary side bar, Configure Layout).
+ *
+ * Each icon is an SVG in ./layout-icons used as a mask, so it takes the button's colour
+ * (hover, active, disabled) from the theme. Only the alpha of the SVG matters; draw it
+ * in any single colour on a transparent 16x16 canvas. See docs/reskin/ICONS.md.
+ * Scoped to the title bar so the same icon ids keep their stock look in menus.
+ */
+
+.monaco-workbench .part.titlebar :is(
+	.codicon-panel-left, .codicon-panel-left-off,
+	.codicon-panel-right, .codicon-panel-right-off,
+	.codicon-panel-bottom, .codicon-panel-layout-icon, .codicon-panel-layout-icon-off,
+	.codicon-auxiliarybar-left-layout-icon, .codicon-auxiliarybar-left-off-layout-icon,
+	.codicon-auxiliarybar-right-layout-icon, .codicon-auxiliarybar-right-off-layout-icon,
+	.codicon-configure-layout-icon
+)::before {
+	content: '';
+	display: block;
+	width: 16px;
+	height: 16px;
+	background-color: currentColor;
+	-webkit-mask-repeat: no-repeat;
+	-webkit-mask-position: center;
+	-webkit-mask-size: 16px 16px;
+}
+
+.monaco-workbench .part.titlebar :is(.codicon-panel-left, .codicon-auxiliarybar-left-layout-icon)::before {
+	-webkit-mask-image: url('./layout-icons/sidebar-left.svg');
+}
+
+.monaco-workbench .part.titlebar :is(.codicon-panel-left-off, .codicon-auxiliarybar-left-off-layout-icon)::before {
+	-webkit-mask-image: url('./layout-icons/sidebar-left-off.svg');
+}
+
+.monaco-workbench .part.titlebar :is(.codicon-panel-right, .codicon-auxiliarybar-right-layout-icon)::before {
+	-webkit-mask-image: url('./layout-icons/sidebar-right.svg');
+}
+
+.monaco-workbench .part.titlebar :is(.codicon-panel-right-off, .codicon-auxiliarybar-right-off-layout-icon)::before {
+	-webkit-mask-image: url('./layout-icons/sidebar-right-off.svg');
+}
+
+.monaco-workbench .part.titlebar :is(.codicon-panel-bottom, .codicon-panel-layout-icon)::before {
+	-webkit-mask-image: url('./layout-icons/panel.svg');
+}
+
+.monaco-workbench .part.titlebar .codicon-panel-layout-icon-off::before {
+	-webkit-mask-image: url('./layout-icons/panel-off.svg');
+}
+
+.monaco-workbench .part.titlebar .codicon-configure-layout-icon::before {
+	-webkit-mask-image: url('./layout-icons/layout.svg');
+}
+
+/*
+ * More icons, same method. Files live in ./ui-icons; each is drawn on a 16x16 canvas and
+ * scaled to the icon's font size (24px in the activity bar, 16px elsewhere), taking the
+ * colour of the surrounding text.
+ */
+
+.monaco-workbench .activitybar :is(
+	.codicon-explorer-view-icon, .codicon-search-view-icon, .codicon-source-control-view-icon,
+	.codicon-run-view-icon, .codicon-extensions-view-icon
+)::before,
+.monaco-workbench :is(.activitybar, .part.titlebar) :is(.codicon-accounts-view-bar-icon, .codicon-settings-view-bar-icon)::before,
+.agent-sessions-workbench .sessions-account-titlebar-widget-icon.codicon-account::before,
+.monaco-workbench .part.statusbar :is(.codicon-remote, .codicon-bell)::before {
+	content: '';
+	display: block;
+	width: 1em;
+	height: 1em;
+	background-color: currentColor;
+	-webkit-mask-repeat: no-repeat;
+	-webkit-mask-position: center;
+	-webkit-mask-size: 100% 100%;
+}
+
+/* Activity bar */
+.monaco-workbench .activitybar .codicon-explorer-view-icon::before { -webkit-mask-image: url('./ui-icons/explorer.svg'); }
+.monaco-workbench .activitybar .codicon-search-view-icon::before { -webkit-mask-image: url('./ui-icons/search.svg'); }
+.monaco-workbench .activitybar .codicon-source-control-view-icon::before { -webkit-mask-image: url('./ui-icons/source-control.svg'); }
+.monaco-workbench .activitybar .codicon-run-view-icon::before { -webkit-mask-image: url('./ui-icons/run-debug.svg'); }
+.monaco-workbench .activitybar .codicon-extensions-view-icon::before { -webkit-mask-image: url('./ui-icons/extensions.svg'); }
+
+/* Accounts and Settings (activity bar, or title bar when the activity bar is moved there) and the Agents Window account button */
+.monaco-workbench :is(.activitybar, .part.titlebar) .codicon-accounts-view-bar-icon::before,
+.agent-sessions-workbench .sessions-account-titlebar-widget-icon.codicon-account::before { -webkit-mask-image: url('./ui-icons/user.svg'); }
+.monaco-workbench :is(.activitybar, .part.titlebar) .codicon-settings-view-bar-icon::before { -webkit-mask-image: url('./ui-icons/settings.svg'); }
+
+/* Status bar: remote window and notifications (the "unread" and "muted" bells keep the stock icons until they have their own files) */
+.monaco-workbench .part.statusbar .codicon-remote::before { -webkit-mask-image: url('./ui-icons/new-remote-window.svg'); }
+.monaco-workbench .part.statusbar .codicon-bell::before { -webkit-mask-image: url('./ui-icons/notifications.svg'); }
