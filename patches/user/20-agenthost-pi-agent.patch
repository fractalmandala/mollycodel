+			let lastError: string | undefined;
+			const parts = new Map<string, string>();
+			const unsubscribe = agent.subscribe(event => {
+				if (event.type === 'message_start' && event.message.role === 'assistant') {
+					parts.clear();
+				} else if (event.type === 'message_update') {
+					this._onMessageUpdate(chat, turnId, parts, event.assistantMessageEvent);
+				} else if (event.type === 'tool_execution_end') {
+					this._onToolEnd(entry, turnId, event.toolCallId, event.result, event.isError);
+				} else if (event.type === 'message_end' && event.message.role === 'assistant') {
+					const message = event.message;
+					this._fire(chat, {
+						type: ActionType.ChatUsage,
+						turnId,
+						usage: { inputTokens: message.usage.input, outputTokens: message.usage.output, cacheReadTokens: message.usage.cacheRead, model: `${message.provider}/${message.model}` },
+					});
+					if (message.stopReason === 'error') {
+						lastError = message.errorMessage ?? 'The model returned an error.';
+					}
+				}
+			});
