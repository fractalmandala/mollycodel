+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { spawn, type ChildProcess } from 'child_process';
+import { existsSync } from 'fs';
+import { homedir } from 'os';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { join } from '../../../../base/common/path.js';
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { ILogService } from '../../../log/common/log.js';
+
+const START_TIMEOUT_MS = 30_000;
+const LISTENING = /listening on (https?:\/\/[^\s]+)/;
+
+/**
+ * Runs OpenCode under a tiny supervisor so it cannot outlive the host.
+ *
+ * A normal-exit handler is not enough: when the app terminates its agent host the
+ * handler never runs, and the server would be left running forever (one leaked
+ * server per app launch). The supervisor polls for the host's pid and takes the
+ * server down with it, whether the host exited, was terminated, or was killed.
+ * Arguments: the OpenCode binary, the host pid, then OpenCode's own arguments.
+ */
+const SUPERVISOR = `BIN="$1"; PARENT="$2"; shift 2
+"$BIN" "$@" &
+CHILD=$!
+trap 'kill $CHILD 2>/dev/null' EXIT
+trap 'exit 0' TERM INT HUP
+while kill -0 "$PARENT" 2>/dev/null && kill -0 "$CHILD" 2>/dev/null; do sleep 1; done`;
+
+export interface IOpenCodeConnection {
+	readonly url: string;
+	/** Value for the `Authorization` header. */
+	readonly authorization: string;
+}
+
+/** Where to look for the OpenCode binary, most specific first. */
+function candidateBinaries(): string[] {
+	const home = homedir();
+	return [
+		process.env['OPENCODE_BIN'],
+		join(home, '.opencode', 'bin', 'opencode'),
+		'/opt/homebrew/bin/opencode',
+		'/usr/local/bin/opencode',
+	].filter((candidate): candidate is string => !!candidate);
+}
+
+export function findOpenCodeBinary(): string | undefined {
+	return candidateBinaries().find(candidate => existsSync(candidate));
+}
+
+/**
+ * Runs one private `opencode serve` for the lifetime of the agent host.
+ *
+ * It listens on 127.0.0.1 only, on a port the OS picks, protected by a random
+ * password that exists only in this process. OpenCode reads the user's own
+ * configuration (providers, keys, agents, MCP servers), so nothing about it is
+ * copied or stored here.
+ */
+export class OpenCodeServer extends Disposable {
+
+	private _starting: Promise<IOpenCodeConnection> | undefined;
+	private _child: ChildProcess | undefined;
+	private readonly _killOnExit = () => this._child?.kill();
+
+	constructor(@ILogService private readonly _logService: ILogService) {
+		super();
+		process.once('exit', this._killOnExit);
+	}
+
+	/** Start the server if needed. Rejects with a readable reason when OpenCode is not installed. */
+	start(): Promise<IOpenCodeConnection> {
+		this._starting ??= this._spawn().catch(error => {
+			this._starting = undefined;
+			throw error;
+		});
+		return this._starting;
+	}
+
+	private _spawn(): Promise<IOpenCodeConnection> {
+		const binary = findOpenCodeBinary();
+		if (!binary) {
+			return Promise.reject(new Error('OpenCode was not found. Install it from https://opencode.ai, or set OPENCODE_BIN to its path.'));
+		}
+		const password = generateUuid();
+		const args = ['serve', '--hostname', '127.0.0.1', '--port', '0'];
+		const options = { cwd: homedir(), env: { ...process.env, OPENCODE_SERVER_PASSWORD: password }, stdio: ['ignore', 'pipe', 'pipe'] as ['ignore', 'pipe', 'pipe'] };
+		const child = this._child = process.platform === 'win32'
+			? spawn(binary, args, options)
+			: spawn('/bin/sh', ['-c', SUPERVISOR, 'sh', binary, String(process.pid), ...args], options);
+		this._logService.info(`[OpenCode] starting ${binary}`);
+
+		return new Promise<IOpenCodeConnection>((resolve, reject) => {
+			let output = '';
+			const timer = setTimeout(() => {
+				child.kill();
+				reject(new Error('OpenCode did not start in time.'));
+			}, START_TIMEOUT_MS);
+			const onData = (chunk: Buffer) => {
+				output = (output + chunk.toString('utf8')).slice(-4000);
+				const match = LISTENING.exec(output);
+				if (match) {
+					clearTimeout(timer);
+					this._logService.info('[OpenCode] server ready');
+					resolve({ url: match[1], authorization: `Basic ${Buffer.from(`opencode:${password}`).toString('base64')}` });
+				}
+			};
+			child.stdout?.on('data', onData);
+			child.stderr?.on('data', onData);
+			child.once('error', error => {
+				clearTimeout(timer);
+				reject(error);
+			});
+			child.once('exit', code => {
+				clearTimeout(timer);
+				this._logService.info(`[OpenCode] server exited (${code})`);
+				this._child = undefined;
+				this._starting = undefined;
+				reject(new Error(`OpenCode exited (code ${code}) before it was ready.`));
+			});
+		});
+	}
+
+	override dispose(): void {
+		process.removeListener('exit', this._killOnExit);
+		this._child?.kill();
+		this._child = undefined;
+		super.dispose();
+	}
+}
