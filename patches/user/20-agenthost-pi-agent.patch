@@ -0,0 +1,97 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { IOpenCodeConnection } from './opencodeServer.js';
+
+/** A loosely-typed JSON value; OpenCode payloads are validated where they are read. */
+export type OcJson = { [key: string]: any };
+
+/** One event from the global stream: which project it belongs to, and the event itself. */
+export interface IOpenCodeGlobalEvent {
+	readonly directory?: string;
+	readonly payload: OcJson;
+}
+
+/**
+ * Minimal client for the OpenCode server: JSON requests and the server-sent
+ * event stream. Deliberately not the OpenCode SDK: the server speaks newer
+ * events than the SDK's types describe, and the endpoints used here are plain REST.
+ */
+export class OpenCodeHttp {
+
+	constructor(private readonly _connection: IOpenCodeConnection) { }
+
+	private _url(path: string, directory?: string): string {
+		const url = new URL(path, this._connection.url);
+		if (directory) {
+			url.searchParams.set('directory', directory);
+		}
+		return url.toString();
+	}
+
+	private _headers(json = false): Record<string, string> {
+		return { Authorization: this._connection.authorization, Accept: 'application/json', ...(json ? { 'Content-Type': 'application/json' } : {}) };
+	}
+
+	async get<T = OcJson>(path: string, directory?: string, signal?: AbortSignal): Promise<T> {
+		const response = await fetch(this._url(path, directory), { headers: this._headers(), signal });
+		return this._read<T>(response, `GET ${path}`);
+	}
+
+	async post<T = OcJson>(path: string, body: unknown, directory?: string, signal?: AbortSignal): Promise<T> {
+		const response = await fetch(this._url(path, directory), { method: 'POST', headers: this._headers(true), body: JSON.stringify(body ?? {}), signal });
+		return this._read<T>(response, `POST ${path}`);
+	}
+
+	private async _read<T>(response: Response, label: string): Promise<T> {
+		const text = await response.text();
+		if (!response.ok) {
+			let message = text;
+			try {
+				const parsed = JSON.parse(text) as OcJson;
+				message = parsed['data']?.['message'] ?? parsed['message'] ?? parsed['error'] ?? text;
+			} catch { /* keep the raw text */ }
+			throw new Error(`${label} failed (${response.status}): ${String(message).slice(0, 300)}`);
+		}
+		return (text ? JSON.parse(text) : undefined) as T;
+	}
+
+	/**
+	 * Read the global event stream until `signal` aborts or the connection drops
+	 * (the caller reconnects). Server-sent events are blocks separated by a blank
+	 * line, each with one or more `data:` lines holding JSON.
+	 */
+	async streamEvents(onEvent: (event: IOpenCodeGlobalEvent) => void, signal: AbortSignal): Promise<void> {
+		const response = await fetch(this._url('/global/event'), { headers: { ...this._headers(), Accept: 'text/event-stream' }, signal });
+		if (!response.ok || !response.body) {
+			throw new Error(`GET /global/event failed (${response.status})`);
+		}
+		const reader = response.body.getReader();
+		const decoder = new TextDecoder();
+		let buffer = '';
+		for (; ;) {
+			const { done, value } = await reader.read();
+			if (done) {
+				return;
+			}
+			buffer += decoder.decode(value, { stream: true });
+			let boundary: number;
+			while ((boundary = buffer.search(/\r?\n\r?\n/)) >= 0) {
+				const block = buffer.slice(0, boundary);
+				buffer = buffer.slice(boundary).replace(/^\r?\n\r?\n/, '');
+				const data = block.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+				if (!data) {
+					continue;
+				}
+				try {
+					const parsed = JSON.parse(data) as OcJson;
+					onEvent(parsed['payload'] ? { directory: parsed['directory'], payload: parsed['payload'] } : { payload: parsed });
+				} catch {
+					// Ignore a malformed block rather than dropping the whole stream.
+				}
+			}
+		}
+	}
+}
