+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { timeout } from '../../../../base/common/async.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { observableValue } from '../../../../base/common/observable.js';
+import { URI } from '../../../../base/common/uri.js';
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { ILogService } from '../../../log/common/log.js';
+import type { ResolveSessionConfigResult, SessionConfigCompletionsResult } from '../../common/state/protocol/commands.js';
+import type { AgentSelection, MessageAttachment, ModelSelection, ProtectedResourceMetadata } from '../../common/state/protocol/state.js';
+import { ActionType } from '../../common/state/sessionActions.js';
+import { MessageKind, ResponsePartKind, ToolCallConfirmationReason, ToolCallStatus, ToolResultContentType, TurnState, type Customization, type ToolCallResult, type Turn } from '../../common/state/sessionState.js';
+import type { AgentSignal, IActiveClient, IAgent, IAgentChatConfigCompletionsParams, IAgentChatContext, IAgentChatDataChange, IAgentChatMetadata, IAgentChats, IAgentCreateChatOptions, IAgentCreateChatResult, IAgentDescriptor, IAgentDiscoveredChat, IAgentModelInfo, IAgentResolveChatConfigParams } from '../../common/agent.js';
+import { OpenCodeHttp, type OcJson } from './opencodeHttp.js';
+import { OpenCodeServer } from './opencodeServer.js';
+import { homedir } from 'os';
+
+/** Provider id for the OpenCode harness. */
+export const OPENCODE_AGENT_PROVIDER_ID = 'opencode';
+
+const SETUP_MODEL_ID = 'opencode-setup-required';
+const EVENT_RECONNECT_MS = 1000;
+
+interface IOcTool {
+	started: boolean;
+	ready: boolean;
+	finished: boolean;
+}
+
+interface IOcTurn {
+	readonly id: string;
+	readonly startedAt: number;
+	aborted: boolean;
+	/** Streamed text/reasoning parts: how many characters have been sent to the host. */
+	readonly parts: Map<string, { readonly kind: 'text' | 'reasoning'; emitted: number }>;
+	readonly tools: Map<string, IOcTool>;
+}
+
+interface IOcChat {
+	readonly chat: URI;
+	readonly startTime: number;
+	modifiedTime: number;
+	sessionId: string | undefined;
+	directory: string | undefined;
+	/** `providerID/modelID`, or undefined for OpenCode's own default. */
+	model: string | undefined;
+	agent: string | undefined;
+	turn: IOcTurn | undefined;
+}
+
+/** What is persisted per chat so the OpenCode session can be re-attached after a restart. */
+interface IOcProviderData {
+	readonly sessionId: string;
+	readonly directory: string;
+	readonly model?: string;
+	readonly agent?: string;
+}
+
+/**
+ * OpenCode as an agent.
+ *
+ * Runs the user's own OpenCode (their providers, keys, agents, skills, MCP servers
+ * and `AGENTS.md`) behind a private local server and maps its events onto the Agent
+ * Host protocol. This class holds no credentials: OpenCode reads its own configuration.
+ */
+export class OpenCodeAgent extends Disposable implements IAgent {
+
+	readonly id = OPENCODE_AGENT_PROVIDER_ID;
+
+	private readonly _onDidChatProgress = this._register(new Emitter<AgentSignal>());
+	readonly onDidChatProgress = this._onDidChatProgress.event;
+	readonly onDidMaterializeChat = Event.None;
+	private readonly _onDidChangeChatData = this._register(new Emitter<IAgentChatDataChange>());
+	readonly onDidChangeChatData = this._onDidChangeChatData.event;
+	readonly onDidSpawnChat = Event.None;
+	readonly onDidDiscoverChats: Event<readonly IAgentDiscoveredChat[]> = Event.None;
+
+	private readonly _models = observableValue<readonly IAgentModelInfo[]>(this, [setupModel('Starting OpenCode...')]);
+	readonly models = this._models;
+
+	private readonly _server: OpenCodeServer;
+	private _http: Promise<OpenCodeHttp> | undefined;
+	private readonly _eventAbort = new AbortController();
+
+	private readonly _chats = new Map<string, IOcChat>();
+	private readonly _bySession = new Map<string, IOcChat>();
+	/** messageID -> role, so streamed parts of the user's own message are not echoed back. */
+	private readonly _roles = new Map<string, string>();
+	private readonly _usageSent = new Set<string>();
+	/** Tool call id -> the permission request waiting for the user. */
+	private readonly _permissions = new Map<string, { readonly sessionId: string; readonly directory: string; readonly requestId: string }>();
+
+	constructor(
+		@ILogService private readonly _logService: ILogService,
+	) {
+		super();
+		this._server = this._register(new OpenCodeServer(_logService));
+		this._register({ dispose: () => this._eventAbort.abort() });
+		void this.refreshModels();
+	}
+
+	getDescriptor(): IAgentDescriptor {
+		return {
+			provider: OPENCODE_AGENT_PROVIDER_ID,
+			displayName: 'OpenCode',
+			description: 'OpenCode, with your own providers, agents and tools',
+			capabilities: {},
+		};
+	}
+
+	// ---- Connection ----------------------------------------------------------
+
+	private _connect(): Promise<OpenCodeHttp> {
+		this._http ??= (async () => {
+			const connection = await this._server.start();
+			const http = new OpenCodeHttp(connection);
+			void this._runEvents(http);
+			return http;
+		})().catch(error => {
+			this._http = undefined;
+			throw error;
+		});
+		return this._http;
+	}
+
+	private async _runEvents(http: OpenCodeHttp): Promise<void> {
+		while (!this._eventAbort.signal.aborted) {
+			try {
+				await http.streamEvents(event => this._onEvent(event.payload), this._eventAbort.signal);
+			} catch (error) {
+				if (this._eventAbort.signal.aborted) {
+					return;
+				}
+				this._logService.warn(`[OpenCode] event stream dropped: ${error instanceof Error ? error.message : String(error)}`);
+			}
+			await timeout(EVENT_RECONNECT_MS);
+		}
+	}
+
+	/** Publish OpenCode's configured models. */
+	async refreshModels(): Promise<void> {
+		try {
+			const http = await this._connect();
+			const result = await http.get<{ providers?: OcJson[] }>('/config/providers');
+			const infos: IAgentModelInfo[] = [];
+			for (const provider of result.providers ?? []) {
+				for (const model of Object.values<OcJson>(provider['models'] ?? {})) {
+					infos.push({
+						provider: OPENCODE_AGENT_PROVIDER_ID,
+						id: `${provider['id']}/${model['id']}`,
+						name: `${model['name'] ?? model['id']} (${provider['name'] ?? provider['id']})`,
+						maxContextWindow: model['limit']?.['context'] || undefined,
+						maxOutputTokens: model['limit']?.['output'] || undefined,
+						supportsVision: !!(model['modalities']?.['input']?.includes?.('image') ?? model['attachment']),
+					});
+				}
+			}
+			this._logService.info(`[OpenCode] publishing ${infos.length} models`);
+			this._models.set(infos.length ? infos : [setupModel('OpenCode has no providers configured. Add one in OpenCode.')], undefined);
+		} catch (error) {
+			this._logService.warn(`[OpenCode] unavailable: ${error instanceof Error ? error.message : String(error)}`);
+			this._models.set([setupModel(error instanceof Error ? error.message : String(error))], undefined);
+		}
+	}
+
+	// ---- Chats ---------------------------------------------------------------
+
+	private _entry(chat: URI): IOcChat {
+		const key = chat.toString();
+		let entry = this._chats.get(key);
+		if (!entry) {
+			const now = Date.now();
+			entry = { chat, startTime: now, modifiedTime: now, sessionId: undefined, directory: undefined, model: undefined, agent: undefined, turn: undefined };
+			this._chats.set(key, entry);
+		}
+		return entry;
+	}
+
+	private _fire(chat: URI, action: Extract<AgentSignal, { kind: 'action' }>['action']): void {
+		this._onDidChatProgress.fire({ kind: 'action', resource: chat, action });
+	}
+
+	private _persist(entry: IOcChat): void {
+		if (entry.sessionId && entry.directory) {
+			const data: IOcProviderData = { sessionId: entry.sessionId, directory: entry.directory, model: entry.model, agent: entry.agent };
+			this._onDidChangeChatData.fire({ chat: entry.chat, providerData: JSON.stringify(data) });
+		}
+	}
+
+	readonly chats: IAgentChats = {
+		createChat: async (chat: URI, _context: URI | IAgentChatContext, options?: IAgentCreateChatOptions): Promise<IAgentCreateChatResult | void> => {
+			const entry = this._entry(chat);
+			entry.model = options?.model?.id;
+			entry.directory = options?.workingDirectories?.[0]?.fsPath;
+			return { resolvedWorkingDirectory: options?.workingDirectories?.[0] };
+		},
+		disposeChat: async (chat: URI): Promise<void> => {
+			const entry = this._chats.get(chat.toString());
+			if (entry?.sessionId) {
+				this._bySession.delete(entry.sessionId);
+			}
+			this._chats.delete(chat.toString());
+		},
+		releaseChat: async (): Promise<void> => { },
+		sendMessage: async (chat: URI, prompt: string, workingDirectories: readonly URI[] | URI | undefined, _attachments?: readonly MessageAttachment[], turnId?: string): Promise<void> => {
+			const cwd = Array.isArray(workingDirectories) ? workingDirectories[0] : (workingDirectories as URI | undefined);
+			// Asynchronous: progress arrives through the event stream.
+			void this._runTurn(this._entry(chat), prompt, turnId ?? generateUuid(), cwd?.fsPath);
+		},
+		abort: async (chat: URI): Promise<void> => {
+			const entry = this._chats.get(chat.toString());
+			if (entry?.turn && entry.sessionId && entry.directory) {
+				entry.turn.aborted = true;
+				const http = await this._connect();
+				await http.post(`/session/${entry.sessionId}/abort`, {}, entry.directory).catch(error => this._logService.warn(`[OpenCode] abort failed: ${error instanceof Error ? error.message : String(error)}`));
+			}
+		},
+		getModel: (chat: URI): ModelSelection | undefined => {
+			const model = this._chats.get(chat.toString())?.model;
+			return model ? { id: model } : undefined;
+		},
+		changeModel: async (chat: URI, model: ModelSelection): Promise<void> => {
+			const entry = this._entry(chat);
+			entry.model = model.id === SETUP_MODEL_ID ? undefined : model.id;
+			this._persist(entry);
+		},
+		changeAgent: async (chat: URI, agent: AgentSelection | undefined): Promise<void> => {
+			const entry = this._entry(chat);
+			entry.agent = agent ? String(agent.uri).split('/').pop() || undefined : undefined;
+			this._persist(entry);
+		},
+		getMessages: async (chat: URI): Promise<readonly Turn[]> => {
+			const entry = this._chats.get(chat.toString());
+			if (!entry?.sessionId || !entry.directory) {
+				return [];
+			}
+			try {
+				const http = await this._connect();
+				return toTurns(await http.get<OcJson[]>(`/session/${entry.sessionId}/message`, entry.directory));
+			} catch (error) {
+				this._logService.warn(`[OpenCode] could not read history: ${error instanceof Error ? error.message : String(error)}`);
+				return [];
+			}
+		},
+	};
+
+	private async _runTurn(entry: IOcChat, prompt: string, turnId: string, cwd: string | undefined): Promise<void> {
+		const startedAt = Date.now();
+		const turn: IOcTurn = { id: turnId, startedAt, aborted: false, parts: new Map(), tools: new Map() };
+		const fail = (errorType: string, message: string) => {
+			if (entry.turn === turn) {
+				entry.turn = undefined;
+			}
+			this._fire(entry.chat, { type: ActionType.ChatError, turnId, duration: Date.now() - startedAt, error: { errorType, message } });
+		};
+		try {
+			const http = await this._connect();
+			entry.directory = cwd ?? entry.directory ?? homedir();
+			entry.modifiedTime = startedAt;
+			if (!entry.sessionId) {
+				const session = await http.post<OcJson>('/session', {}, entry.directory);
+				entry.sessionId = session['id'] as string;
+				this._bySession.set(entry.sessionId, entry);
+				this._persist(entry);
+			}
+			entry.turn = turn;
+			const body: OcJson = { parts: [{ type: 'text', text: prompt }] };
+			if (entry.model) {
+				const [providerID, ...rest] = entry.model.split('/');
+				body['model'] = { providerID, modelID: rest.join('/') };
+			}
+			if (entry.agent) {
+				body['agent'] = entry.agent;
+			}
+			// The request returns when the run finishes; events carry the progress.
+			await http.post(`/session/${entry.sessionId}/message`, body, entry.directory);
+			// Fallback if the idle event was missed (stream reconnecting): finish the turn here.
+			await timeout(400);
+			this._completeTurn(entry, turn);
+		} catch (error) {
+			if (!turn.aborted && entry.turn === turn) {
+				fail('opencode.error', error instanceof Error ? error.message : String(error));
+			} else if (!entry.turn) {
+				fail('opencode.error', error instanceof Error ? error.message : String(error));
+			}
+		}
+	}
+
+	private _completeTurn(entry: IOcChat, turn: IOcTurn): void {
+		if (entry.turn !== turn) {
+			return;
+		}
+		entry.turn = undefined;
+		if (!turn.aborted) {
+			this._fire(entry.chat, { type: ActionType.ChatTurnComplete, turnId: turn.id, duration: Date.now() - turn.startedAt });
+		}
+	}
+
+	// ---- Events --------------------------------------------------------------
+
+	private _onEvent(event: OcJson): void {
+		const type = event['type'] as string | undefined;
+		const props = (event['properties'] ?? {}) as OcJson;
+		switch (type) {
+			case 'message.updated': {
+				const info = props['info'] as OcJson | undefined;
+				if (!info) {
+					return;
+				}
+				this._roles.set(info['id'], info['role']);
+				const entry = this._bySession.get(info['sessionID']);
+				if (entry?.turn && info['role'] === 'assistant' && info['tokens']?.['output'] > 0 && !this._usageSent.has(info['id'])) {
+					this._usageSent.add(info['id']);
+					this._fire(entry.chat, {
+						type: ActionType.ChatUsage,
+						turnId: entry.turn.id,
+						usage: { inputTokens: info['tokens']['input'], outputTokens: info['tokens']['output'], cacheReadTokens: info['tokens']['cache']?.['read'], model: `${info['providerID']}/${info['modelID']}` },
+					});
+				}
+				return;
+			}
+			case 'message.part.updated': {
+				const part = props['part'] as OcJson | undefined;
+				const entry = part && this._bySession.get(part['sessionID']);
+				if (!part || !entry?.turn || this._roles.get(part['messageID']) !== 'assistant') {
+					return;
+				}
+				this._onPart(entry, entry.turn, part);
+				return;
+			}
+			case 'message.part.delta': {
+				const entry = this._bySession.get(props['sessionID']);
+				const state = entry?.turn?.parts.get(props['partID']);
+				if (!entry?.turn || !state || props['field'] !== 'text' || !props['delta']) {
+					return;
+				}
+				state.emitted += (props['delta'] as string).length;
+				this._fireDelta(entry, entry.turn, props['partID'], state.kind, props['delta']);
+				return;
+			}
+			case 'permission.asked':
+			case 'permission.updated': {
+				const entry = this._bySession.get(props['sessionID']);
+				if (entry?.turn) {
+					this._onPermission(entry, entry.turn, props);
+				}
+				return;
+			}
+			case 'question.asked': {
+				void this._rejectQuestion(props);
+				return;
+			}
+			case 'session.idle': {
+				const entry = this._bySession.get(props['sessionID']);
+				if (entry?.turn) {
+					this._completeTurn(entry, entry.turn);
+				}
+				return;
+			}
+			case 'session.error': {
+				const entry = this._bySession.get(props['sessionID']);
+				const turn = entry?.turn;
+				if (!entry || !turn) {
+					return;
+				}
+				entry.turn = undefined;
+				if (!turn.aborted) {
+					const error = props['error'] as OcJson | undefined;
+					this._fire(entry.chat, { type: ActionType.ChatError, turnId: turn.id, duration: Date.now() - turn.startedAt, error: { errorType: `opencode.${error?.['name'] ?? 'error'}`, message: String(error?.['data']?.['message'] ?? error?.['name'] ?? 'OpenCode reported an error.') } });
+				}
+				return;
+			}
+		}
+	}
+
+	private _onPart(entry: IOcChat, turn: IOcTurn, part: OcJson): void {
+		switch (part['type']) {
+			case 'text':
+			case 'reasoning': {
+				if (part['synthetic'] || part['ignored']) {
+					return;
+				}
+				const kind = part['type'] as 'text' | 'reasoning';
+				const text = (part['text'] as string | undefined) ?? '';
+				const state = turn.parts.get(part['id']);
+				if (!state) {
+					turn.parts.set(part['id'], { kind, emitted: text.length });
+					this._fire(entry.chat, { type: ActionType.ChatResponsePart, turnId: turn.id, part: { kind: kind === 'text' ? ResponsePartKind.Markdown : ResponsePartKind.Reasoning, id: part['id'], content: text } });
+				} else if (text.length > state.emitted) {
+					const delta = text.slice(state.emitted);
+					state.emitted = text.length;
+					this._fireDelta(entry, turn, part['id'], kind, delta);
+				}
+				return;
+			}
+			case 'tool':
+				this._onToolPart(entry, turn, part);
+				return;
+		}
+	}
+
+	private _fireDelta(entry: IOcChat, turn: IOcTurn, partId: string, kind: 'text' | 'reasoning', content: string): void {
+		this._fire(entry.chat, kind === 'text'
+			? { type: ActionType.ChatDelta, turnId: turn.id, partId, content }
+			: { type: ActionType.ChatReasoning, turnId: turn.id, partId, content });
+	}
+
+	private _tool(turn: IOcTurn, callId: string): IOcTool {
+		let tool = turn.tools.get(callId);
+		if (!tool) {
+			tool = { started: false, ready: false, finished: false };
+			turn.tools.set(callId, tool);
+		}
+		return tool;
+	}
+
+	private _startTool(entry: IOcChat, turn: IOcTurn, callId: string, name: string): IOcTool {
+		const tool = this._tool(turn, callId);
+		if (!tool.started) {
+			tool.started = true;
+			this._fire(entry.chat, { type: ActionType.ChatToolCallStart, turnId: turn.id, toolCallId: callId, toolName: name, displayName: prettify(name) });
+		}
+		return tool;
+	}
+
+	private _onToolPart(entry: IOcChat, turn: IOcTurn, part: OcJson): void {
+		const callId = part['callID'] as string;
+		const state = (part['state'] ?? {}) as OcJson;
+		const name = String(part['tool']);
+		const tool = this._startTool(entry, turn, callId, name);
+		const status = state['status'];
+		const title = (state['title'] as string | undefined) || prettify(name);
+		if (!tool.ready && (status === 'running' || status === 'completed' || status === 'error')) {
+			tool.ready = true;
+			this._fire(entry.chat, { type: ActionType.ChatToolCallReady, turnId: turn.id, toolCallId: callId, invocationMessage: title, toolInput: safeJson(state['input']), confirmed: ToolCallConfirmationReason.NotNeeded });
+		}
+		if (tool.finished || (status !== 'completed' && status !== 'error')) {
+			return;
+		}
+		tool.finished = true;
+		const output = status === 'completed' ? String(state['output'] ?? '') : '';
+		const result: ToolCallResult = {
+			success: status === 'completed',
+			pastTenseMessage: title,
+			content: output ? [{ type: ToolResultContentType.Text, text: output.slice(0, 20_000) }] : undefined,
+			error: status === 'error' ? { message: String(state['error'] ?? 'The tool failed.') } : undefined,
+		};
+		this._fire(entry.chat, { type: ActionType.ChatToolCallComplete, turnId: turn.id, toolCallId: callId, result });
+	}
+
+	private _onPermission(entry: IOcChat, turn: IOcTurn, props: OcJson): void {
+		const requestId = props['id'] as string;
+		const kind = String(props['permission'] ?? props['type'] ?? 'tool');
+		const callId = (props['tool']?.['callID'] ?? props['callID'] ?? `permission-${requestId}`) as string;
+		const patterns = ([] as string[]).concat(props['patterns'] ?? props['pattern'] ?? []);
+		const tool = this._startTool(entry, turn, callId, kind);
+		tool.ready = true; // the pending confirmation moves the tool call forward
+		this._permissions.set(callId, { sessionId: entry.sessionId!, directory: entry.directory!, requestId });
+		const title = String(props['title'] ?? prettify(kind));
+		this._onDidChatProgress.fire({
+			kind: 'pending_confirmation',
+			chat: entry.chat,
+			state: {
+				status: ToolCallStatus.PendingConfirmation,
+				toolCallId: callId,
+				toolName: kind,
+				displayName: prettify(kind),
+				invocationMessage: title,
+				toolInput: patterns.join('\n') || undefined,
+				confirmationTitle: title,
+			},
+			permissionKind: permissionKindFor(kind),
+			permissionPath: patterns[0],
+		});
+	}
+
+	private async _rejectQuestion(props: OcJson): Promise<void> {
+		// Interactive questions are not supported in this window yet; decline so the run continues.
+		try {
+			const http = await this._connect();
+			await http.post(`/api/session/${props['sessionID']}/question/${props['id']}/reject`, {});
+		} catch (error) {
+			this._logService.warn(`[OpenCode] could not decline a question: ${error instanceof Error ? error.message : String(error)}`);
+		}
+	}
+
+	respondToPermissionRequest(requestId: string, approved: boolean): void {
+		const pending = this._permissions.get(requestId);
+		if (!pending) {
+			return;
+		}
+		this._permissions.delete(requestId);
+		void (async () => {
+			const http = await this._connect();
+			try {
+				await http.post(`/api/session/${pending.sessionId}/permission/${pending.requestId}/reply`, { reply: approved ? 'once' : 'reject' }, pending.directory);
+			} catch {
+				// Older servers answer on the classic endpoint.
+				await http.post(`/session/${pending.sessionId}/permissions/${pending.requestId}`, { response: approved ? 'once' : 'reject' }, pending.directory);
+			}
+		})().catch(error => this._logService.warn(`[OpenCode] could not answer a permission request: ${error instanceof Error ? error.message : String(error)}`));
+	}
+
+	// ---- Restore and metadata ------------------------------------------------
+
+	async materializeChat(chat: URI, _context: URI | IAgentChatContext, providerData: string | undefined): Promise<IAgentCreateChatResult | void> {
+		const entry = this._entry(chat);
+		if (!providerData) {
+			return;
+		}
+		try {
+			const data = JSON.parse(providerData) as IOcProviderData;
+			entry.sessionId = data.sessionId;
+			entry.directory = data.directory;
+			entry.model = data.model;
+			entry.agent = data.agent;
+			this._bySession.set(data.sessionId, entry);
+		} catch {
+			this._logService.warn('[OpenCode] ignoring unreadable chat data');
+		}
+	}
+
+	async getChatMetadata(chat: URI): Promise<IAgentChatMetadata | undefined> {
+		const entry = this._chats.get(chat.toString());
+		return entry && { chat, startTime: entry.startTime, modifiedTime: entry.modifiedTime, workingDirectories: entry.directory ? [URI.file(entry.directory)] : undefined };
+	}
+
+	async listChatsToMigrate(): Promise<readonly IAgentChatMetadata[] | undefined> {
+		return [];
+	}
+
+	// ---- Clients and interaction --------------------------------------------
+
+	getOrCreateActiveClient(_chat: URI, _context: URI | IAgentChatContext, client: { readonly clientId: string; readonly displayName?: string }, _hostCustomizations?: readonly Customization[]): IActiveClient {
+		return { clientId: client.clientId, displayName: client.displayName, tools: [], customizations: [] };
+	}
+
+	removeActiveClient(): void { }
+
+	onClientToolCallComplete(_chat: URI, _toolCallId: string, _result: ToolCallResult): void { }
+
+	respondToUserInputRequest(): void { }
+
+	// ---- Configuration -------------------------------------------------------
+
+	async resolveChatConfig(params: IAgentResolveChatConfigParams): Promise<ResolveSessionConfigResult> {
+		return { schema: { type: 'object', properties: {} }, values: params.config ?? {} };
+	}
+
+	getInheritedChatConfig(): undefined {
+		return undefined;
+	}
+
+	async chatConfigCompletions(_params: IAgentChatConfigCompletionsParams): Promise<SessionConfigCompletionsResult> {
+		return { items: [] };
+	}
+
+	async getChatCustomizations(): Promise<readonly Customization[]> {
+		return [];
+	}
+
+	// ---- Authentication ------------------------------------------------------
+
+	getProtectedResources(): ProtectedResourceMetadata[] {
+		return [];
+	}
+
+	async authenticate(_resource: string, _token: string): Promise<boolean> {
+		return true;
+	}
+
+	// ---- Lifecycle -----------------------------------------------------------
+
+	async shutdown(): Promise<void> {
+		this._eventAbort.abort();
+	}
+}
+
+function setupModel(reason: string): IAgentModelInfo {
+	return { provider: OPENCODE_AGENT_PROVIDER_ID, id: SETUP_MODEL_ID, name: reason, supportsVision: false };
+}
+
+function prettify(name: string): string {
+	const spaced = name.replace(/[_-]+/g, ' ').trim();
+	return spaced ? spaced.charAt(0).toUpperCase() + spaced.slice(1) : 'Tool';
+}
+
+function safeJson(value: unknown): string | undefined {
+	try {
+		return value === undefined ? undefined : JSON.stringify(value);
+	} catch {
+		return undefined;
+	}
+}
+
+/** OpenCode permission names mapped onto the host's approval categories. */
+function permissionKindFor(kind: string): 'shell' | 'write' | 'read' | 'url' | 'mcp' | 'custom-tool' {
+	switch (kind) {
+		case 'bash': return 'shell';
+		case 'edit': case 'write': case 'patch': case 'multiedit': return 'write';
+		case 'read': case 'list': case 'glob': case 'grep': case 'external_directory': return 'read';
+		case 'webfetch': case 'websearch': return 'url';
+		default: return kind.includes('_') || kind.includes('mcp') ? 'mcp' : 'custom-tool';
+	}
+}
+
+/** Rebuild host turns from OpenCode's stored messages (text and reasoning; tool calls are omitted). */
+function toTurns(items: readonly OcJson[]): Turn[] {
+	const turns: Turn[] = [];
+	let current: Turn | undefined;
+	for (const item of items) {
+		const info = (item['info'] ?? {}) as OcJson;
+		const parts = (item['parts'] ?? []) as OcJson[];
+		if (info['role'] === 'user') {
+			const text = parts.filter(part => part['type'] === 'text' && !part['synthetic']).map(part => part['text']).join('\n');
+			current = { id: info['id'], startedAt: new Date(info['time']?.['created'] ?? Date.now()).toISOString(), message: { text, origin: { kind: MessageKind.User } }, responseParts: [], usage: undefined, state: TurnState.Complete };
+			turns.push(current);
+		} else if (current && info['role'] === 'assistant') {
+			for (const part of parts) {
+				if ((part['type'] === 'text' || part['type'] === 'reasoning') && part['text']) {
+					current.responseParts.push({ kind: part['type'] === 'text' ? ResponsePartKind.Markdown : ResponsePartKind.Reasoning, id: part['id'], content: part['text'] });
+				}
+			}
+			if (info['tokens']) {
+				current.usage = { inputTokens: info['tokens']['input'], outputTokens: info['tokens']['output'], model: `${info['providerID']}/${info['modelID']}` };
+			}
+			if (info['error']) {
+				current.state = TurnState.Error;
+				current.error = { errorType: `opencode.${info['error']['name'] ?? 'error'}`, message: String(info['error']['data']?.['message'] ?? 'OpenCode reported an error.') };
+			}
+			if (info['time']?.['created'] && info['time']?.['completed']) {
+				current.duration = info['time']['completed'] - info['time']['created'];
+			}
+		}
+	}
+	return turns;
+}
