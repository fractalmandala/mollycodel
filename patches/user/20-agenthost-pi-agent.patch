--- /dev/null
+++ b/src/vs/platform/agentHost/node/pi/piSubagents.ts
@@ -0,0 +1,345 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { promises as fs } from 'fs';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+import { Type } from 'typebox';
+import { join } from '../../../../base/common/path.js';
+import type { PiToolName } from './piTools.js';
+
+/**
+ * Sub-agents for Pi: the main agent can hand a self-contained task to a fresh agent
+ * with its own instructions and (optionally narrower) tools, and get a written report
+ * back. Several can run at once: Pi runs the tool calls of one reply in parallel.
+ *
+ * Agent types are Markdown files with a small header, so they can be written and
+ * shared like skills:
+ *
+ *     ---
+ *     name: reviewer
+ *     description: Reviews a change for bugs. Use after edits.
+ *     tools: read_file, list_dir
+ *     model: anthropic/claude-sonnet-4-6      (optional; default is the main agent's model)
+ *     ---
+ *     You are a careful code reviewer...
+ *
+ * They are read from `<project>/.pi/agents`, `<project>/.agents/agents` and
+ * `~/.mollycodel/agents`; a project file overrides a personal one, which overrides
+ * a built-in type of the same name. Sub-agents cannot start sub-agents.
+ */
+
+export const SUBAGENT_TOOL_NAME = 'Agent';
+
+/** At most this many sub-agents work at the same time; further ones wait their turn. */
+export const MAX_CONCURRENT_SUBAGENTS = 4;
+/** A sub-agent that has not finished after this many replies is stopped and its progress reported. */
+export const MAX_SUBAGENT_TURNS = 40;
+const MAX_REPORT_CHARS = 30_000;
+
+const ALL_TOOLS: readonly PiToolName[] = ['read_file', 'list_dir', 'write_file', 'edit_file', 'bash'];
+const READ_ONLY_TOOLS: readonly PiToolName[] = ['read_file', 'list_dir'];
+
+export interface IPiSubagentType {
+	readonly name: string;
+	readonly description: string;
+	readonly tools: readonly PiToolName[];
+	readonly systemPrompt: string;
+	/** `provider/id` or a bare model id; the main agent's model when unset. */
+	readonly model?: string;
+	readonly source: 'built-in' | 'user' | 'project';
+}
+
+export const BUILTIN_SUBAGENT_TYPES: readonly IPiSubagentType[] = [
+	{
+		name: 'general-purpose',
+		description: 'General-purpose agent for multi-step tasks that need searching, reading and changing files or running commands.',
+		tools: ALL_TOOLS,
+		systemPrompt: 'Complete the task you are given thoroughly, then report what you found or did.',
+		source: 'built-in',
+	},
+	{
+		name: 'Explore',
+		description: 'Fast, read-only exploration of the codebase: find where something lives, how it works, what calls it. Cannot change anything.',
+		tools: READ_ONLY_TOOLS,
+		systemPrompt: 'You explore the codebase and answer questions about it. You can only read and list files. Be efficient: search broadly, then read what matters. Report findings with file paths and line numbers.',
+		source: 'built-in',
+	},
+	{
+		name: 'Plan',
+		description: 'Read-only planning: study the code and produce a concrete step-by-step implementation plan. Cannot change anything.',
+		tools: READ_ONLY_TOOLS,
+		systemPrompt: 'You design implementation plans. Read the relevant code, then give an ordered plan naming the files to change and why, plus risks and how to verify. Do not write the code.',
+		source: 'built-in',
+	},
+];
+
+const TOOL_ALIASES: Readonly<Record<string, PiToolName>> = {
+	read_file: 'read_file', read: 'read_file', view: 'read_file',
+	list_dir: 'list_dir', ls: 'list_dir', list: 'list_dir', glob: 'list_dir',
+	write_file: 'write_file', write: 'write_file',
+	edit_file: 'edit_file', edit: 'edit_file',
+	bash: 'bash', shell: 'bash',
+};
+
+function parseToolList(value: string): PiToolName[] | undefined {
+	const names = value.replace(/^\[|\]$/g, '').split(',').map(part => part.trim().replace(/^['"]|['"]$/g, '').toLowerCase()).filter(Boolean);
+	if (!names.length) {
+		return undefined;
+	}
+	const tools = new Set<PiToolName>();
+	for (const name of names) {
+		const tool = TOOL_ALIASES[name];
+		if (tool) {
+			tools.add(tool);
+		}
+	}
+	return [...tools];
+}
+
+/** Parse one agent file. Returns `undefined` when it has no usable name or instructions. */
+export function parseSubagentFile(text: string, fallbackName: string, source: 'user' | 'project'): IPiSubagentType | undefined {
+	const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/.exec(text);
+	const header = new Map<string, string>();
+	let body = text;
+	if (match) {
+		body = match[2];
+		for (const line of match[1].split(/\r?\n/)) {
+			const colon = line.indexOf(':');
+			if (colon > 0) {
+				header.set(line.slice(0, colon).trim().toLowerCase(), line.slice(colon + 1).trim().replace(/^['"]|['"]$/g, ''));
+			}
+		}
+	}
+	const name = (header.get('name') ?? fallbackName).trim();
+	const systemPrompt = body.trim();
+	if (!/^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/.test(name) || !systemPrompt) {
+		return undefined;
+	}
+	let tools: readonly PiToolName[] = ALL_TOOLS;
+	const listed = header.get('tools');
+	if (listed && listed !== '*') {
+		tools = parseToolList(listed) ?? ALL_TOOLS;
+	}
+	const denied = header.get('disallowed_tools') ?? header.get('disallowedtools');
+	if (denied) {
+		const blocked = new Set(parseToolList(denied) ?? []);
+		tools = tools.filter(tool => !blocked.has(tool));
+	}
+	return {
+		name,
+		description: header.get('description') || `Custom agent "${name}".`,
+		tools,
+		systemPrompt,
+		model: header.get('model') || undefined,
+		source,
+	};
+}
+
+async function readAgentDir(dir: string, source: 'user' | 'project'): Promise<IPiSubagentType[]> {
+	let names: string[];
+	try {
+		names = (await fs.readdir(dir)).filter(name => name.toLowerCase().endsWith('.md')).sort();
+	} catch {
+		return [];
+	}
+	const result: IPiSubagentType[] = [];
+	for (const file of names.slice(0, 100)) {
+		try {
+			const stat = await fs.stat(join(dir, file));
+			if (!stat.isFile() || stat.size > 100_000) {
+				continue;
+			}
+			const type = parseSubagentFile(await fs.readFile(join(dir, file), 'utf8'), file.replace(/\.md$/i, ''), source);
+			if (type) {
+				result.push(type);
+			}
+		} catch {
+			// An unreadable agent file is skipped, not fatal.
+		}
+	}
+	return result;
+}
+
+/** Built-in types, then personal ones, then the project's; a later definition replaces an earlier one of the same name. */
+export async function loadSubagentTypes(cwd: string, home: string): Promise<IPiSubagentType[]> {
+	const byName = new Map<string, IPiSubagentType>();
+	const layers = [
+		BUILTIN_SUBAGENT_TYPES,
+		await readAgentDir(join(home, '.mollycodel', 'agents'), 'user'),
+		await readAgentDir(join(cwd, '.agents', 'agents'), 'project'),
+		await readAgentDir(join(cwd, '.pi', 'agents'), 'project'),
+	];
+	for (const layer of layers) {
+		for (const type of layer) {
+			byName.set(type.name.toLowerCase(), type);
+		}
+	}
+	return [...byName.values()];
+}
+
+/** Case-insensitive lookup; `undefined` when no such type exists. */
+export function findSubagentType(types: readonly IPiSubagentType[], name: string | undefined): IPiSubagentType | undefined {
+	const wanted = (name ?? 'general-purpose').trim().toLowerCase();
+	return types.find(type => type.name.toLowerCase() === wanted);
+}
+
+/** Only the tools the type is allowed. */
+export function toolsForType<T extends { readonly name: string }>(tools: readonly T[], type: IPiSubagentType): T[] {
+	const allowed = new Set<string>(type.tools);
+	return tools.filter(tool => allowed.has(tool.name));
+}
+
+/** Limits how many sub-agents run at once; the rest wait in order. */
+export class SubagentLimiter {
+	private _running = 0;
+	private readonly _waiting: (() => void)[] = [];
+
+	constructor(private readonly _max: number = MAX_CONCURRENT_SUBAGENTS) { }
+
+	async run<T>(fn: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+		if (this._running >= this._max) {
+			await new Promise<void>((resolve, reject) => {
+				const waiter = () => { signal?.removeEventListener('abort', onAbort); resolve(); };
+				const onAbort = () => {
+					const index = this._waiting.indexOf(waiter);
+					if (index >= 0) {
+						this._waiting.splice(index, 1);
+					}
+					reject(new Error('Cancelled before it could start.'));
+				};
+				signal?.addEventListener('abort', onAbort, { once: true });
+				this._waiting.push(waiter);
+			});
+		}
+		this._running++;
+		try {
+			return await fn();
+		} finally {
+			this._running--;
+			this._waiting.shift()?.();
+		}
+	}
+}
+
+/** The parts of the Pi agent a sub-agent run needs. Kept narrow so this file stays testable on its own. */
+export interface ISubagentRunHost {
+	readonly cwd: string;
+	readonly types: readonly IPiSubagentType[];
+	readonly limiter: SubagentLimiter;
+	/** The model for a run: `selection` when given and available, otherwise the main agent's. */
+	resolveModel(selection: string | undefined): unknown | undefined;
+	/** A fresh agent configured with the given instructions, model and tools. */
+	createAgent(options: { readonly systemPrompt: string; readonly model: unknown; readonly tools: AgentTool[] }): SubagentAgent;
+	/** The tools a sub-agent may use, before the type's filter. */
+	createTools(): AgentTool[];
+	/** Approval gate for this sub-agent's tool calls; `label` names it for the user, `idPrefix` keeps call ids unique. */
+	gate(label: string, idPrefix: string): unknown;
+	/** A sub-agent tool call finished (so its card can be completed). */
+	toolEnded(idPrefix: string, toolCallId: string, result: unknown, isError: boolean): void;
+	nextRunId(): number;
+}
+
+/** The slice of a Pi `Agent` used here. */
+export interface SubagentAgent {
+	beforeToolCall: unknown;
+	readonly state: { tools: AgentTool[]; readonly messages: readonly { readonly role: string; readonly content?: unknown; readonly stopReason?: string; readonly errorMessage?: string }[] };
+	subscribe(listener: (event: { readonly type: string; readonly toolCallId?: string; readonly result?: unknown; readonly isError?: boolean; readonly message?: { readonly role: string } }) => void): () => void;
+	prompt(text: string): Promise<void>;
+	abort(): void;
+}
+
+function textOfMessage(content: unknown): string {
+	if (typeof content === 'string') {
+		return content;
+	}
+	return Array.isArray(content)
+		? content.filter((block): block is { type: string; text: string } => !!block && typeof block === 'object' && (block as { type?: unknown }).type === 'text' && typeof (block as { text?: unknown }).text === 'string').map(block => block.text).join('\n')
+		: '';
+}
+
+export interface ISubagentOutcome {
+	readonly report: string;
+	readonly stopped?: 'turn-limit' | 'cancelled';
+}
+
+/** Run one sub-agent to completion and return its written report. Throws when the model fails. */
+export async function runSubagent(host: ISubagentRunHost, type: IPiSubagentType, prompt: string, signal: AbortSignal | undefined): Promise<ISubagentOutcome> {
+	const model = host.resolveModel(type.model);
+	if (!model) {
+		throw new Error(`No model is available for the "${type.name}" agent.`);
+	}
+	const runId = host.nextRunId();
+	const idPrefix = `sub${runId}:`;
+	const agent = host.createAgent({
+		systemPrompt: [
+			'You are a sub-agent working for another agent on one delegated task.',
+			`The working directory is ${host.cwd}. Reply with a complete, self-contained final report: it is the only thing the requester will see.`,
+			type.systemPrompt,
+		].join('\n\n'),
+		model,
+		tools: toolsForType(host.createTools(), type),
+	});
+	agent.beforeToolCall = host.gate(type.name, idPrefix);
+
+	let turns = 0;
+	let stopped: ISubagentOutcome['stopped'];
+	const unsubscribe = agent.subscribe(event => {
+		if (event.type === 'tool_execution_end' && event.toolCallId) {
+			host.toolEnded(idPrefix, event.toolCallId, event.result, event.isError === true);
+		} else if (event.type === 'message_end' && event.message?.role === 'assistant' && ++turns >= MAX_SUBAGENT_TURNS) {
+			stopped = 'turn-limit';
+			agent.abort();
+		}
+	});
+	const onAbort = () => { stopped ??= 'cancelled'; agent.abort(); };
+	signal?.addEventListener('abort', onAbort, { once: true });
+	try {
+		await agent.prompt(prompt);
+	} finally {
+		signal?.removeEventListener('abort', onAbort);
+		unsubscribe();
+	}
+
+	const assistant = [...agent.state.messages].reverse().filter(message => message.role === 'assistant');
+	const last = assistant[0];
+	if (last?.stopReason === 'error' && !stopped) {
+		throw new Error(last.errorMessage ?? 'The model returned an error.');
+	}
+	const text = assistant.map(message => textOfMessage(message.content).trim()).find(Boolean) ?? '';
+	let report = text || '(The agent finished without writing a report.)';
+	if (stopped === 'turn-limit') {
+		report += `\n\n[Stopped after ${MAX_SUBAGENT_TURNS} replies without finishing; this is its progress so far.]`;
+	} else if (stopped === 'cancelled') {
+		report += '\n\n[Cancelled before it finished.]';
+	}
+	return { report: report.length > MAX_REPORT_CHARS ? `${report.slice(0, MAX_REPORT_CHARS)}\n[report truncated]` : report, stopped };
+}
+
+/** The `Agent` tool the main agent calls to delegate. */
+export function createSubagentTool(host: ISubagentRunHost): AgentTool {
+	const catalog = host.types.map(type => `- ${type.name}: ${type.description} (tools: ${type.tools.join(', ')})`).join('\n');
+	return {
+		name: SUBAGENT_TOOL_NAME,
+		label: 'Sub-agent',
+		description: [
+			'Hand a self-contained task to a sub-agent that works on its own and returns a written report.',
+			'Use it to search or read widely without filling this conversation, or to do independent pieces of work at the same time:',
+			'call Agent several times in one reply and they run in parallel. Write the prompt as a complete brief; the sub-agent has not seen this conversation.',
+			`Available types:\n${catalog}`,
+		].join(' '),
+		parameters: Type.Object({
+			description: Type.String({ description: 'A short (3-6 word) label for the task.' }),
+			prompt: Type.String({ description: 'The complete task for the sub-agent.' }),
+			subagent_type: Type.Optional(Type.String({ description: 'Which type of agent to use. Default: general-purpose.' })),
+		}),
+		execute: async (_id, params: { description: string; prompt: string; subagent_type?: string }, signal?: AbortSignal) => {
+			const requested = params.subagent_type;
+			const type = findSubagentType(host.types, requested);
+			const note = requested && !type ? `[Unknown agent type "${requested}"; used general-purpose.]\n\n` : '';
+			const outcome = await host.limiter.run(() => runSubagent(host, type ?? findSubagentType(host.types, 'general-purpose') ?? BUILTIN_SUBAGENT_TYPES[0], params.prompt, signal), signal);
+			return { content: [{ type: 'text' as const, text: note + outcome.report }], details: { agent: type?.name ?? 'general-purpose', stopped: outcome.stopped } };
+		},
+	} as AgentTool;
+}
