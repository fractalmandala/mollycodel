+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { localize2 } from '../../../../nls.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IPiProvidersEditorService, PiProvidersEditorService } from './piProvidersEditor.js';
+import { IPiProvidersService, PiProvidersService } from './piProvidersService.js';
+
+export const PI_MANAGE_PROVIDERS_COMMAND_ID = 'workbench.action.pi.manageProviders';
+
+registerSingleton(IPiProvidersService, PiProvidersService, InstantiationType.Delayed);
+registerSingleton(IPiProvidersEditorService, PiProvidersEditorService, InstantiationType.Delayed);
+
+/** Instantiates the provider service at startup so its keys reach the agent host without opening the editor. */
+class PiProvidersSyncContribution extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.piProviders';
+
+	constructor(@IPiProvidersService _providers: IPiProvidersService) {
+		super();
+	}
+}
+
+registerWorkbenchContribution2(PiProvidersSyncContribution.ID, PiProvidersSyncContribution, WorkbenchPhase.AfterRestored);
+
+registerAction2(class ManagePiProvidersAction extends Action2 {
+	constructor() {
+		super({
+			id: PI_MANAGE_PROVIDERS_COMMAND_ID,
+			title: localize2('pi.manageProviders', "Pi: Manage Providers"),
+			f1: true,
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		accessor.get(IPiProvidersEditorService).open();
+	}
+});
diff --git a/src/vs/workbench/contrib/piProviders/browser/piProvidersEditor.ts b/src/vs/workbench/contrib/piProviders/browser/piProvidersEditor.ts
