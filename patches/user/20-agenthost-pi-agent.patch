+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { Credential, CredentialInfo, CredentialStore } from '@earendil-works/pi-ai';
+import { PI_PROVIDER_PRESETS } from '../../common/piProviderPresets.js';
+import type { IPiModelConfig, IPiProviderConfig, IPiProvidersPayload, PiModelApi } from '../../common/piProviders.js';
+
+export type PiAi = typeof import('@earendil-works/pi-ai');
+export type PiCore = typeof import('@earendil-works/pi-agent-core');
+type PiOpenAiCompletions = typeof import('@earendil-works/pi-ai/api/openai-completions.lazy');
+type PiAnthropicMessages = typeof import('@earendil-works/pi-ai/api/anthropic-messages.lazy');
+export type PiModels = ReturnType<PiAi['createModels']>;
+export type PiModel = NonNullable<ReturnType<PiModels['getModel']>>;
+
+/** Modules the runtime needs, loaded lazily so a missing package cannot break host startup. */
+export interface IPiDeps {
+	readonly ai: PiAi;
+	readonly core: PiCore;
+	readonly openai: PiOpenAiCompletions;
+	readonly anthropic: PiAnthropicMessages;
+}
+
+export async function loadPiDeps(): Promise<IPiDeps> {
+	const [ai, core, openai, anthropic] = await Promise.all([
+		import('@earendil-works/pi-ai'),
+		import('@earendil-works/pi-agent-core'),
+		import('@earendil-works/pi-ai/api/openai-completions.lazy'),
+		import('@earendil-works/pi-ai/api/anthropic-messages.lazy'),
+	]);
+	return { ai, core, openai, anthropic };
+}
+
+type PiProvider = ReturnType<PiAi['createProvider']>;
+const KNOWN_BUILTIN_IDS: ReadonlySet<string> = new Set(PI_PROVIDER_PRESETS.map(preset => preset.id));
+
+/**
+ * Load one built-in provider by id.
+ *
+ * Deliberately not `providers/all`: that entry statically imports a hidden dotfile
+ * (`data/.manifest.json`) which this app's packaging step strips from node_modules,
+ * so it cannot load in the built app. Per-provider modules only import plain files.
+ * Only ids from the generated preset list are accepted.
+ */
+async function loadBuiltinProvider(id: string): Promise<PiProvider | undefined> {
+	if (!KNOWN_BUILTIN_IDS.has(id)) {
+		return undefined;
+	}
+	const module = await import(`@earendil-works/pi-ai/providers/${id}`) as Record<string, unknown>;
+	// Factory names follow the id (`anthropic` -> `anthropicProvider`) but acronyms differ
+	// (`azureOpenAIResponsesProvider`), so match case-insensitively.
+	const wanted = `${id.replace(/-/g, '')}provider`;
+	const key = Object.keys(module).find(name => name.toLowerCase() === wanted);
+	const factory = key ? module[key] : undefined;
+	return typeof factory === 'function' ? (factory as () => PiProvider)() : undefined;
+}
+
+/** In-memory `CredentialStore`: `modify` is the only write path; returning `undefined` leaves the entry unchanged. */
+export class PiMemoryCredentialStore implements CredentialStore {
+	private readonly _map = new Map<string, Credential>();
+
+	set(providerId: string, credential: Credential): void {
+		this._map.set(providerId, credential);
+	}
+
+	async read(providerId: string): Promise<Credential | undefined> {
+		return this._map.get(providerId);
+	}
+
+	async list(): Promise<readonly CredentialInfo[]> {
+		return [...this._map].map(([providerId, credential]) => ({ providerId, type: credential.type }));
+	}
+
+	async modify(providerId: string, fn: (current: Credential | undefined) => Promise<Credential | undefined>): Promise<Credential | undefined> {
+		const current = this._map.get(providerId);
+		const next = await fn(current);
+		if (next === undefined) {
+			return current;
+		}
+		this._map.set(providerId, next);
+		return next;
+	}
+
+	async delete(providerId: string): Promise<void> {
+		this._map.delete(providerId);
+	}
+}
+
+/** Fallback limits for a model id Pi's catalog does not know (a generic text-only model). */
+const FALLBACK_CONTEXT_WINDOW = 128_000;
+const FALLBACK_MAX_TOKENS = 16_384;
+
+/**
+ * Build a Pi model collection from configured providers.
+ *
+ * Pi's catalog is authoritative for metadata of models it knows (even when they
+ * are served through a custom endpoint); unknown ids still work as plain
+ * text-only models with conservative limits.
+ */
+export async function buildPiModels(deps: IPiDeps, payload: IPiProvidersPayload): Promise<PiModels> {
+	const credentials = new PiMemoryCredentialStore();
+
+	// Start from an empty collection so only enabled rows are offered.
+	const collection = deps.ai.createModels({ credentials });
+	// Metadata for model ids Pi already knows, taken from the built-in providers in use.
+	const known = new Map<string, PiModel>();
+	const enabled = payload.providers.filter(row => row.enabled);
+
+	for (const row of enabled.filter(candidate => candidate.kind === 'builtin')) {
+		try {
+			const provider = await loadBuiltinProvider(row.id);
+			if (!provider) {
+				continue;
+			}
+			collection.setProvider(provider);
+			if (row.apiKey) {
+				credentials.set(provider.id, { type: 'api_key', key: row.apiKey });
+			}
+			for (const model of provider.getModels()) {
+				if (!known.has(model.id)) {
+					known.set(model.id, model as PiModel);
+				}
+			}
+		} catch {
+			// One provider failing to load must not take the others down.
+		}
+	}
+	if (enabled.some(candidate => candidate.kind === 'command-code')) {
+		// Command Code serves Claude models under their own ids; Pi's catalog knows their limits and capabilities.
+		await addKnownModels(known, 'anthropic');
+	}
+	for (const row of enabled.filter(candidate => candidate.kind !== 'builtin')) {
+		collection.setProvider(buildCustomProvider(deps, row, row.apiKey, known));
+	}
+	return collection;
+}
+
+async function addKnownModels(known: Map<string, PiModel>, builtinId: string): Promise<void> {
+	try {
+		const provider = await loadBuiltinProvider(builtinId);
+		for (const model of provider?.getModels() ?? []) {
+			if (!known.has(model.id)) {
+				known.set(model.id, model as PiModel);
+			}
+		}
+	} catch {
+		// Metadata is a nicety; models still work with conservative limits.
+	}
+}
+
+/** Command Code serves Claude models over the Anthropic protocol and everything else over OpenAI's. */
+export function commandCodeApiFor(config: IPiModelConfig): PiModelApi {
+	return config.api ?? (config.id.startsWith('claude-') ? 'anthropic-messages' : 'openai-completions');
+}
+
+/** The Anthropic protocol is rooted one level above the OpenAI one (`.../provider/v1` -> `.../provider`). */
+export function commandCodeBaseUrl(baseUrl: string, api: PiModelApi): string {
+	const normalized = baseUrl.replace(/\/+$/, '');
+	return api === 'anthropic-messages' && normalized.endsWith('/v1') ? normalized.slice(0, -3) : normalized;
+}
+
+// Command Code's gateway does not accept every OpenAI/Anthropic extension, so those are switched off.
+const COMMAND_CODE_OPENAI_COMPAT = { supportsStore: false, supportsDeveloperRole: false, maxTokensField: 'max_tokens' };
+const COMMAND_CODE_ANTHROPIC_COMPAT = { supportsEagerToolInputStreaming: false, supportsLongCacheRetention: false, supportsCacheControlOnTools: false, supportsToolReferences: false };
+
+function buildCustomProvider(deps: IPiDeps, row: IPiProviderConfig, apiKey: string | undefined, known: ReadonlyMap<string, PiModel>) {
+	const isCommandCode = row.kind === 'command-code';
+	const isAnthropic = row.kind === 'anthropic-compatible';
+	const api = isAnthropic ? 'anthropic-messages' : 'openai-completions';
+	const baseUrl = (row.baseUrl ?? '').replace(/\/+$/, '');
+	const toModel = (config: IPiModelConfig): PiModel => {
+		const catalog = known.get(config.id);
+		const modelApi = isCommandCode ? commandCodeApiFor(config) : api;
+		const modelBaseUrl = isCommandCode ? commandCodeBaseUrl(baseUrl, modelApi) : baseUrl;
+		const base = {
+			id: config.id,
+			name: config.alias ?? catalog?.name ?? config.id,
+			api: modelApi,
+			provider: row.id,
+			baseUrl: modelBaseUrl,
+			reasoning: catalog?.reasoning ?? false,
+			input: catalog?.input ?? ['text'],
+			cost: catalog?.cost ?? { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+			contextWindow: config.contextWindow ?? catalog?.contextWindow ?? FALLBACK_CONTEXT_WINDOW,
+			maxTokens: config.maxTokens ?? catalog?.maxTokens ?? FALLBACK_MAX_TOKENS,
+			headers: row.headers ? { ...row.headers } : undefined,
+			...(isCommandCode ? { compat: modelApi === 'anthropic-messages' ? COMMAND_CODE_ANTHROPIC_COMPAT : COMMAND_CODE_OPENAI_COMPAT } : {}),
+		};
+		return base as unknown as PiModel;
+	};
+	return deps.ai.createProvider({
+		id: row.id,
+		name: row.name,
+		baseUrl,
+		// A configured key wins; an empty key resolves as a keyless endpoint (local servers).
+		auth: { apiKey: { name: `${row.name} API key`, resolve: async () => ({ auth: apiKey ? { apiKey } : {} }) } },
+		models: row.models.map(toModel),
+		api: isCommandCode
+			? { 'openai-completions': deps.openai.openAICompletionsApi(), 'anthropic-messages': deps.anthropic.anthropicMessagesApi() }
+			: isAnthropic ? deps.anthropic.anthropicMessagesApi() : deps.openai.openAICompletionsApi(),
+	} as never);
+}
