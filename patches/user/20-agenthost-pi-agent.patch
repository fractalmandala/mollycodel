+
+type PiAgentInstance = InstanceType<IPiDeps['core']['Agent']>;
+type PiBeforeToolCall = NonNullable<PiAgentInstance['beforeToolCall']>;
+
+/** Provider id for the Pi agent harness. */
+export const PI_AGENT_PROVIDER_ID = 'pi';
+
+/** Model id published when no provider credentials are configured, so the picker explains how to fix it. */
+const SETUP_MODEL_ID = 'pi-setup-required';
+
+
+/** Gemini catalog entries that are not general chat models. */
+const NON_CHAT_MODEL = /image|live|deep-research|computer-use/;
+
+interface IPiChat {
+	readonly chat: URI;
+	readonly startTime: number;
+	modifiedTime: number;
+	/** Selected model as `provider/id`, or `undefined` for the default. */
+	model: string | undefined;
+	agent: PiAgentInstance | undefined;
