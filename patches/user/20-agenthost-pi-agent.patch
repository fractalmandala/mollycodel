--- /dev/null
+++ b/src/vs/platform/agentHost/node/pi/piProviderRuntime.ts
@@ -0,0 +1,165 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { Credential, CredentialInfo, CredentialStore } from '@earendil-works/pi-ai';
+import { PI_PROVIDER_PRESETS } from '../../common/piProviderPresets.js';
+import type { IPiModelConfig, IPiProviderConfig, IPiProvidersPayload } from '../../common/piProviders.js';
+
+export type PiAi = typeof import('@earendil-works/pi-ai');
+export type PiCore = typeof import('@earendil-works/pi-agent-core');
+type PiOpenAiCompletions = typeof import('@earendil-works/pi-ai/api/openai-completions.lazy');
+type PiAnthropicMessages = typeof import('@earendil-works/pi-ai/api/anthropic-messages.lazy');
+export type PiModels = ReturnType<PiAi['createModels']>;
+export type PiModel = NonNullable<ReturnType<PiModels['getModel']>>;
+
+/** Modules the runtime needs, loaded lazily so a missing package cannot break host startup. */
+export interface IPiDeps {
+	readonly ai: PiAi;
+	readonly core: PiCore;
+	readonly openai: PiOpenAiCompletions;
+	readonly anthropic: PiAnthropicMessages;
+}
+
+export async function loadPiDeps(): Promise<IPiDeps> {
+	const [ai, core, openai, anthropic] = await Promise.all([
+		import('@earendil-works/pi-ai'),
+		import('@earendil-works/pi-agent-core'),
+		import('@earendil-works/pi-ai/api/openai-completions.lazy'),
+		import('@earendil-works/pi-ai/api/anthropic-messages.lazy'),
+	]);
+	return { ai, core, openai, anthropic };
+}
+
+type PiProvider = ReturnType<PiAi['createProvider']>;
+const KNOWN_BUILTIN_IDS: ReadonlySet<string> = new Set(PI_PROVIDER_PRESETS.map(preset => preset.id));
+
+/**
+ * Load one built-in provider by id.
+ *
+ * Deliberately not `providers/all`: that entry statically imports a hidden dotfile
+ * (`data/.manifest.json`) which this app's packaging step strips from node_modules,
+ * so it cannot load in the built app. Per-provider modules only import plain files.
+ * Only ids from the generated preset list are accepted.
+ */
+async function loadBuiltinProvider(id: string): Promise<PiProvider | undefined> {
+	if (!KNOWN_BUILTIN_IDS.has(id)) {
+		return undefined;
+	}
+	const module = await import(`@earendil-works/pi-ai/providers/${id}`) as Record<string, unknown>;
+	// Factory names follow the id (`anthropic` -> `anthropicProvider`) but acronyms differ
+	// (`azureOpenAIResponsesProvider`), so match case-insensitively.
+	const wanted = `${id.replace(/-/g, '')}provider`;
+	const key = Object.keys(module).find(name => name.toLowerCase() === wanted);
+	const factory = key ? module[key] : undefined;
+	return typeof factory === 'function' ? (factory as () => PiProvider)() : undefined;
+}
+
+/** In-memory `CredentialStore`: `modify` is the only write path; returning `undefined` leaves the entry unchanged. */
+export class PiMemoryCredentialStore implements CredentialStore {
+	private readonly _map = new Map<string, Credential>();
+
+	set(providerId: string, credential: Credential): void {
+		this._map.set(providerId, credential);
+	}
+
+	async read(providerId: string): Promise<Credential | undefined> {
+		return this._map.get(providerId);
+	}
+
+	async list(): Promise<readonly CredentialInfo[]> {
+		return [...this._map].map(([providerId, credential]) => ({ providerId, type: credential.type }));
+	}
+
+	async modify(providerId: string, fn: (current: Credential | undefined) => Promise<Credential | undefined>): Promise<Credential | undefined> {
+		const current = this._map.get(providerId);
+		const next = await fn(current);
+		if (next === undefined) {
+			return current;
+		}
+		this._map.set(providerId, next);
+		return next;
+	}
+
+	async delete(providerId: string): Promise<void> {
+		this._map.delete(providerId);
+	}
+}
+
+/** Fallback limits for a model id Pi's catalog does not know (a generic text-only model). */
+const FALLBACK_CONTEXT_WINDOW = 128_000;
+const FALLBACK_MAX_TOKENS = 16_384;
+
+/**
+ * Build a Pi model collection from configured providers.
+ *
+ * Pi's catalog is authoritative for metadata of models it knows (even when they
+ * are served through a custom endpoint); unknown ids still work as plain
+ * text-only models with conservative limits.
+ */
+export async function buildPiModels(deps: IPiDeps, payload: IPiProvidersPayload): Promise<PiModels> {
+	const credentials = new PiMemoryCredentialStore();
+
+	// Start from an empty collection so only enabled rows are offered.
+	const collection = deps.ai.createModels({ credentials });
+	// Metadata for model ids Pi already knows, taken from the built-in providers in use.
+	const known = new Map<string, PiModel>();
+	const enabled = payload.providers.filter(row => row.enabled);
+
+	for (const row of enabled.filter(candidate => candidate.kind === 'builtin')) {
+		try {
+			const provider = await loadBuiltinProvider(row.id);
+			if (!provider) {
+				continue;
+			}
+			collection.setProvider(provider);
+			if (row.apiKey) {
+				credentials.set(provider.id, { type: 'api_key', key: row.apiKey });
+			}
+			for (const model of provider.getModels()) {
+				if (!known.has(model.id)) {
+					known.set(model.id, model as PiModel);
+				}
+			}
+		} catch {
+			// One provider failing to load must not take the others down.
+		}
+	}
+	for (const row of enabled.filter(candidate => candidate.kind !== 'builtin')) {
+		collection.setProvider(buildCustomProvider(deps, row, row.apiKey, known));
+	}
+	return collection;
+}
+
+function buildCustomProvider(deps: IPiDeps, row: IPiProviderConfig, apiKey: string | undefined, known: ReadonlyMap<string, PiModel>) {
+	const isAnthropic = row.kind === 'anthropic-compatible';
+	const api = isAnthropic ? 'anthropic-messages' : 'openai-completions';
+	const baseUrl = (row.baseUrl ?? '').replace(/\/+$/, '');
+	const toModel = (config: IPiModelConfig): PiModel => {
+		const catalog = known.get(config.id);
+		const base = {
+			id: config.id,
+			name: config.alias ?? catalog?.name ?? config.id,
+			api,
+			provider: row.id,
+			baseUrl,
+			reasoning: catalog?.reasoning ?? false,
+			input: catalog?.input ?? ['text'],
+			cost: catalog?.cost ?? { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+			contextWindow: config.contextWindow ?? catalog?.contextWindow ?? FALLBACK_CONTEXT_WINDOW,
+			maxTokens: config.maxTokens ?? catalog?.maxTokens ?? FALLBACK_MAX_TOKENS,
+			headers: row.headers ? { ...row.headers } : undefined,
+		};
+		return base as unknown as PiModel;
+	};
+	return deps.ai.createProvider({
+		id: row.id,
+		name: row.name,
+		baseUrl,
+		// A configured key wins; an empty key resolves as a keyless endpoint (local servers).
+		auth: { apiKey: { name: `${row.name} API key`, resolve: async () => ({ auth: apiKey ? { apiKey } : {} }) } },
+		models: row.models.map(toModel),
+		api: isAnthropic ? deps.anthropic.anthropicMessagesApi() : deps.openai.openAICompletionsApi(),
+	} as never);
+}
diff --git a/src/vs/platform/agentHost/node/pi/piTools.ts b/src/vs/platform/agentHost/node/pi/piTools.ts
new file mode 100644
index 00000000..fb0a719b
--- /dev/null
+++ b/src/vs/platform/agentHost/node/pi/piTools.ts
@@ -0,0 +1,268 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { spawn } from 'child_process';
+import { promises as fs } from 'fs';
+import { homedir } from 'os';
+import type { AgentTool } from '@earendil-works/pi-agent-core';
+import { Type } from 'typebox';
+import { basename, dirname, isAbsolute, relative, resolve } from '../../../../base/common/path.js';
+
+/**
+ * File and shell tools for the Pi agent.
+ *
+ * Safety model (enforced in two places: the approval step in `PiAgent`, via
+ * {@link describePiTool}, and again inside each tool's `execute`):
+ *  - writes and shell commands always require confirmation; the Agent Host
+ *    applies its own approval policy on top using `permissionKind`/`permissionPath`;
+ *  - reads inside the working directory need no confirmation, reads outside do;
+ *  - likely secret files are blocked outright (`.env*`, `~/.ssh`, `~/.aws`, `~/.gnupg`
+ *    and the Pi credentials file), so a model can never read an API key and send it
+ *    to a provider.
+ */
+
+const MAX_READ_LINES = 2000;
+const MAX_TEXT_CHARS = 100_000;
+const MAX_LIST_ENTRIES = 500;
+const MAX_SHELL_OUTPUT_CHARS = 50_000;
+const DEFAULT_SHELL_TIMEOUT_SECONDS = 120;
+
+export type PiToolName = 'read_file' | 'list_dir' | 'write_file' | 'edit_file' | 'bash';
+
+export interface IPiToolInfo {
+	readonly displayName: string;
+	readonly invocationMessage: string;
+	readonly pastTenseMessage: string;
+	/** Raw input shown to the user in the confirmation (a command, a path). */
+	readonly toolInput: string;
+	readonly needsConfirmation: boolean;
+	readonly permissionKind?: 'read' | 'write' | 'shell';
+	readonly permissionPath?: string;
+	/** When set, the call must not run; this is the reason returned to the model. */
+	readonly blockedReason?: string;
+}
+
+function isInside(root: string, target: string): boolean {
+	const rel = relative(root, target);
+	return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));
+}
+
+export function isSecretPath(absolutePath: string): boolean {
+	const name = basename(absolutePath);
+	if (/^\.env(\..*)?$/.test(name)) {
+		return true;
+	}
+	const home = homedir();
+	if (['.ssh', '.aws', '.gnupg'].some(dir => isInside(resolve(home, dir), absolutePath))) {
+		return true;
+	}
+	return false;
+}
+
+const SECRET_REASON = 'Access to likely secret files (.env*, ~/.ssh, ~/.aws, ~/.gnupg) is blocked.';
+
+function asString(value: unknown): string {
+	return typeof value === 'string' ? value : '';
+}
+
+/** Describe a tool call: what to show the user, and whether it needs confirmation or is blocked. */
+export function describePiTool(cwd: string, name: string, args: unknown): IPiToolInfo {
+	const params = (args && typeof args === 'object' ? args : {}) as Record<string, unknown>;
+	const pathArg = asString(params['path']) || '.';
+	const absolute = resolve(cwd, pathArg);
+	const rel = relative(cwd, absolute) || '.';
+
+	switch (name) {
+		case 'read_file':
+		case 'list_dir': {
+			const isList = name === 'list_dir';
+			const outside = !isInside(cwd, absolute);
+			return {
+				displayName: isList ? 'List Directory' : 'Read File',
+				invocationMessage: `${isList ? 'Listing' : 'Reading'} ${rel}`,
+				pastTenseMessage: `${isList ? 'Listed' : 'Read'} ${rel}`,
+				toolInput: absolute,
+				needsConfirmation: outside,
+				permissionKind: 'read',
+				permissionPath: absolute,
+				blockedReason: isSecretPath(absolute) ? SECRET_REASON : undefined,
+			};
+		}
+		case 'write_file':
+		case 'edit_file': {
+			const isEdit = name === 'edit_file';
+			return {
+				displayName: isEdit ? 'Edit File' : 'Write File',
+				invocationMessage: `${isEdit ? 'Editing' : 'Writing'} ${rel}`,
+				pastTenseMessage: `${isEdit ? 'Edited' : 'Wrote'} ${rel}`,
+				toolInput: absolute,
+				needsConfirmation: true,
+				permissionKind: 'write',
+				permissionPath: absolute,
+			};
+		}
+		case 'bash': {
+			const command = asString(params['command']);
+			return {
+				displayName: 'Run Command',
+				invocationMessage: 'Running command',
+				pastTenseMessage: 'Ran command',
+				toolInput: command,
+				needsConfirmation: true,
+				permissionKind: 'shell',
+			};
+		}
+		default:
+			return { displayName: name, invocationMessage: `Running ${name}`, pastTenseMessage: `Ran ${name}`, toolInput: JSON.stringify(params), needsConfirmation: true };
+	}
+}
+
+function text(value: string) {
+	return { content: [{ type: 'text' as const, text: value }], details: {} };
+}
+
+function truncate(value: string, max: number, keep: 'head' | 'tail' = 'head'): string {
+	if (value.length <= max) {
+		return value;
+	}
+	return keep === 'head'
+		? `${value.slice(0, max)}\n[output truncated: ${value.length - max} more characters]`
+		: `[output truncated: ${value.length - max} earlier characters]\n${value.slice(value.length - max)}`;
+}
+
+/** Defence in depth: re-check blocked paths at execution time. */
+function resolveGuarded(cwd: string, name: PiToolName, args: unknown): string {
+	const info = describePiTool(cwd, name, args);
+	if (info.blockedReason) {
+		throw new Error(info.blockedReason);
+	}
+	return info.permissionPath ?? cwd;
+}
+
+export function createPiTools(cwd: string): AgentTool[] {
+	const readFile: AgentTool<ReturnType<typeof readFileSchema>> = {
+		name: 'read_file',
+		label: 'Read File',
+		description: 'Read a text file. Paths are relative to the working directory. Use offset/limit (1-based line numbers) for large files.',
+		parameters: readFileSchema(),
+		execute: async (_id, params) => {
+			const file = resolveGuarded(cwd, 'read_file', params);
+			const lines = (await fs.readFile(file, 'utf8')).split('\n');
+			const start = Math.max(1, Math.floor(params.offset ?? 1));
+			const limit = Math.min(MAX_READ_LINES, Math.max(1, Math.floor(params.limit ?? MAX_READ_LINES)));
+			const slice = lines.slice(start - 1, start - 1 + limit);
+			const header = `[${file}: lines ${start}-${start + slice.length - 1} of ${lines.length}]\n`;
+			return text(header + truncate(slice.join('\n'), MAX_TEXT_CHARS));
+		},
+	};
+
+	const listDir: AgentTool<ReturnType<typeof listDirSchema>> = {
+		name: 'list_dir',
+		label: 'List Directory',
+		description: 'List the entries of a directory (default: the working directory). Directories end with "/".',
+		parameters: listDirSchema(),
+		execute: async (_id, params) => {
+			const dir = resolveGuarded(cwd, 'list_dir', { path: params.path ?? '.' });
+			const entries = await fs.readdir(dir, { withFileTypes: true });
+			const names = entries.map(entry => entry.isDirectory() ? `${entry.name}/` : entry.name).sort();
+			const shown = names.slice(0, MAX_LIST_ENTRIES);
+			return text(shown.join('\n') + (names.length > shown.length ? `\n[${names.length - shown.length} more entries not shown]` : ''));
+		},
+	};
+
+	const writeFile: AgentTool<ReturnType<typeof writeFileSchema>> = {
+		name: 'write_file',
+		label: 'Write File',
+		description: 'Create or overwrite a file with the given content. Parent directories are created.',
+		parameters: writeFileSchema(),
+		execute: async (_id, params) => {
+			const file = resolveGuarded(cwd, 'write_file', params);
+			await fs.mkdir(dirname(file), { recursive: true });
+			await fs.writeFile(file, params.content, 'utf8');
+			return text(`Wrote ${params.content.length} characters to ${file}`);
+		},
+	};
+
+	const editFile: AgentTool<ReturnType<typeof editFileSchema>> = {
+		name: 'edit_file',
+		label: 'Edit File',
+		description: 'Replace exactly one occurrence of oldText with newText in a file. Fails if oldText is missing or appears more than once; include enough surrounding context to make it unique.',
+		parameters: editFileSchema(),
+		execute: async (_id, params) => {
+			const file = resolveGuarded(cwd, 'edit_file', params);
+			const original = await fs.readFile(file, 'utf8');
+			const occurrences = params.oldText ? original.split(params.oldText).length - 1 : 0;
+			if (occurrences !== 1) {
+				throw new Error(occurrences === 0 ? 'oldText was not found in the file.' : `oldText appears ${occurrences} times; make it unique.`);
+			}
+			await fs.writeFile(file, original.replace(params.oldText, () => params.newText), 'utf8');
+			return text(`Edited ${file} (1 replacement)`);
+		},
+	};
+
+	const bash: AgentTool<ReturnType<typeof bashSchema>> = {
+		name: 'bash',
+		label: 'Run Command',
+		description: 'Run a shell command in the working directory and return its combined output. Fails on a non-zero exit code.',
+		parameters: bashSchema(),
+		execute: async (_id, params, signal) => {
+			const timeoutMs = Math.max(1, params.timeoutSeconds ?? DEFAULT_SHELL_TIMEOUT_SECONDS) * 1000;
+			const output = await new Promise<{ code: number | null; text: string }>((resolvePromise, reject) => {
+				const env = { ...process.env };
+				delete env['PI_DOTENV'];
+				const child = spawn(params.command, { cwd, shell: true, signal, env });
+				let combined = '';
+				const onData = (chunk: Buffer) => {
+					combined += chunk.toString('utf8');
+					if (combined.length > MAX_SHELL_OUTPUT_CHARS * 2) {
+						combined = combined.slice(combined.length - MAX_SHELL_OUTPUT_CHARS * 2);
+					}
+				};
+				child.stdout.on('data', onData);
+				child.stderr.on('data', onData);
+				const timer = setTimeout(() => child.kill('SIGKILL'), timeoutMs);
+				child.on('error', error => { clearTimeout(timer); reject(error); });
+				child.on('close', code => { clearTimeout(timer); resolvePromise({ code, text: combined }); });
+			});
+			const body = truncate(output.text, MAX_SHELL_OUTPUT_CHARS, 'tail');
+			if (output.code !== 0) {
+				throw new Error(`Command exited with code ${output.code}.\n${body}`);
+			}
+			return text(body || '(no output)');
+		},
+	};
+
+	return [readFile, listDir, writeFile, editFile, bash] as unknown as AgentTool[];
+}
+
+function readFileSchema() {
+	return Type.Object({
+		path: Type.String({ description: 'File path, relative to the working directory or absolute.' }),
+		offset: Type.Optional(Type.Number({ description: '1-based line to start at.' })),
+		limit: Type.Optional(Type.Number({ description: 'Maximum number of lines to return.' })),
+	});
+}
+function listDirSchema() {
+	return Type.Object({ path: Type.Optional(Type.String({ description: 'Directory path. Defaults to the working directory.' })) });
+}
+function writeFileSchema() {
+	return Type.Object({
+		path: Type.String({ description: 'File path to create or overwrite.' }),
+		content: Type.String({ description: 'Full file content.' }),
+	});
+}
+function editFileSchema() {
+	return Type.Object({
+		path: Type.String({ description: 'File path to edit.' }),
+		oldText: Type.String({ description: 'Exact text to replace; must occur exactly once.' }),
+		newText: Type.String({ description: 'Replacement text.' }),
+	});
+}
+function bashSchema() {
+	return Type.Object({
+		command: Type.String({ description: 'Shell command to run.' }),
+		timeoutSeconds: Type.Optional(Type.Number({ description: 'Timeout in seconds (default 120).' })),
+	});
+}
