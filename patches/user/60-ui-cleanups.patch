+/*---------------------------------------------------------------------------------------------
+ *  mollycodel: the Agents Window account menu leads to AI providers, not a Copilot sign-in.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Codicon } from '../../../../base/common/codicons.js';
+import { localize2 } from '../../../../nls.js';
+import { Action2, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { Menus } from '../../../browser/menus.js';
+
+/** Opens the page where AI providers and their keys are managed. */
+const MANAGE_PROVIDERS_COMMAND_ID = 'workbench.action.pi.manageProviders';
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'mollycodel.sessions.manageProviders',
+			title: localize2('mollycodel.manageProviders', "Manage AI providers"),
+			icon: Codicon.settingsGear,
+			menu: {
+				id: Menus.AccountMenu,
+				group: '1_account',
+				order: 1,
+			}
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		await accessor.get(ICommandService).executeCommand(MANAGE_PROVIDERS_COMMAND_ID);
+	}
+});
